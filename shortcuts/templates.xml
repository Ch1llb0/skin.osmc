	<!-- Carries no controls; it exists to build the shared widget variables -->
	<template items="widgetVariables" source="widgets">
		<!-- The focused widget's list item and the test that selects it. $PARENT and $PROPERTY
		     both resolve here because this is an items template; the same trick inside a
		     propertyGroup would leave $PARENT[index] in the emitted XML. -->
		<property name="widgetItem" value="Container(10$PARENT[index]0$PROPERTY[index]).ListItem" />
		<property name="widgetFocus" value="Control.IsVisible(1000$PARENT[index]) + Control.HasFocus(10$PARENT[index]0$PROPERTY[index])" />
		<propertyGroup content="widgetWeather" />
		<variableGroup content="widgetVars" />
		<controls />
	</template>

	<!-- Reloading spinner -->
	<template include="reloading" menu="mainmenu">
		<controls>
			<skinshortcuts insert="reloadingWidget" />
		</controls>
	</template>

	<template items="reloadingWidget" source="widgets">
		<propertyGroup content="widgetWeather" />
		<controls>
			<control type="image">
				<animation type="Conditional" condition="String.IsEqual(Container(1000$PARENT[index]).ListItem.Property(widgetID),$PARENT[index]-$PROPERTY[index]) + [Container(10$PARENT[index]0$PROPERTY[index]).IsUpdating | $PROPERTY[isWeather] + Weather.IsUpdating]">
					<effect type="fade" start="0" end="100" time="200" />
				</animation>
				<animation type="Conditional" condition="![String.IsEqual(Container(1000$PARENT[index]).ListItem.Property(widgetID),$PARENT[index]-$PROPERTY[index]) + [Container(10$PARENT[index]0$PROPERTY[index]).IsUpdating | $PROPERTY[isWeather] + Weather.IsUpdating]]">
					<effect type="fade" start="100" end="0" time="200" />
				</animation>
				<width>36</width>
				<height>36</height>
				<texture>$VAR[BusySpinner]</texture>
				<visible>String.IsEqual(Container(9000).ListItem.Property(name),$PARENT[name]) + String.IsEqual(Container(1000$PARENT[index]).ListItem.Property(widgetID),$PARENT[index]-$PROPERTY[index]) + [Container(10$PARENT[index]0$PROPERTY[index]).IsUpdating | $PROPERTY[isWeather] + Weather.IsUpdating]</visible>
			</control>
		</controls>
	</template>

</templates>
