<?xml version="1.0" encoding="UTF-8"?>
<templates>

	<!-- Widget dimensions, one row per layout -->
	<presets>
		<preset name="widgetLayout">
			<values condition="layout=wide" layoutWidth="320" layoutHeight="240" imageWidthNoFocus="288" imageHeightNoFocus="216" imageWidthFocus="320" imageHeightFocus="240" overlayHeight="32" overlaySlide="16" />
			<values condition="layout=square" layoutWidth="320" layoutHeight="320" imageWidthNoFocus="288" imageHeightNoFocus="288" imageWidthFocus="320" imageHeightFocus="320" overlayHeight="32" overlaySlide="16" />
			<values condition="layout=square-small" layoutWidth="240" layoutHeight="240" imageWidthNoFocus="216" imageHeightNoFocus="216" imageWidthFocus="240" imageHeightFocus="240" overlayHeight="24" overlaySlide="12" />
			<values layoutWidth="240" layoutHeight="360" imageWidthNoFocus="216" imageHeightNoFocus="324" imageWidthFocus="240" imageHeightFocus="360" overlayHeight="24" overlaySlide="12" />
		</preset>
	</presets>

	<propertyGroups>
		<propertyGroup name="widgetArtwork">
			<!-- Fake landscape composes fanart with a logo, so it needs its own include
			     and its own emptiness test; every other art type tests itself. -->
			<var name="primaryArt">
				<value condition="widgetArt=FAKELANDSCAPE">widget-fakelandscape</value>
				<value condition="widgetArt=FAKETVLANDSCAPE">widget-faketvlandscape</value>
				<value>widget-image</value>
			</var>
			<var name="secondaryArt">
				<value condition="widgetFallbackArt=FAKELANDSCAPE">widget-fakelandscape</value>
				<value condition="widgetFallbackArt=FAKETVLANDSCAPE">widget-faketvlandscape</value>
				<value>widget-image</value>
			</var>
			<var name="secondaryVisibility">
				<value condition="widgetArt=FAKELANDSCAPE">String.IsEmpty(ListItem.Art(fanart)) + String.IsEmpty(ListItem.Art(clearlogo))</value>
				<value condition="widgetArt=FAKETVLANDSCAPE">String.IsEmpty(ListItem.Art(fanart)) + String.IsEmpty(ListItem.Art(tvshow.clearlogo))</value>
				<value>String.IsEmpty(ListItem.$PROPERTY[widgetArt])</value>
			</var>
			<var name="fallbackVisibility">
				<value condition="widgetFallbackArt=FAKELANDSCAPE">String.IsEmpty(ListItem.Art(fanart)) + String.IsEmpty(ListItem.Art(clearlogo))</value>
				<value condition="widgetFallbackArt=FAKETVLANDSCAPE">String.IsEmpty(ListItem.Art(fanart)) + String.IsEmpty(ListItem.Art(tvshow.clearlogo))</value>
				<value>String.IsEmpty(ListItem.$PROPERTY[widgetFallbackArt])</value>
			</var>
			<var name="artFallback">
				<value condition="widgetType=movies">DefaultMovie.png</value>
				<value condition="widgetType=tvshows">DefaultTVShows.png</value>
				<value condition="widgetType=seasons">DefaultTVShows.png</value>
				<value condition="widgetType=episodes">DefaultMovies.png</value>
				<value condition="widgetType=sets">DefaultSets.png</value>
				<value condition="widgetType=music">DefaultMusicAlbums.png</value>
				<value condition="widgetType=albums">DefaultMusicAlbums.png</value>
				<value condition="widgetType=artists">DefaultMusicArtists.png</value>
				<value condition="widgetType=songs">DefaultMusicSongs.png</value>
				<value condition="widgetType=musicvideos">DefaultMusicVideos.png</value>
				<value condition="widgetType=tv">DefaultLiveTV.png</value>
				<value condition="widgetType=radio">DefaultRadio.png</value>
				<value condition="widgetType=games">DefaultGameAddons.png</value>
				<value condition="widgetType=addons">DefaultAddonProgram.png</value>
				<value>DefaultShortcut.png</value>
			</var>
		</propertyGroup>

		<!-- Not artwork: whether this row is the weather widget, which the reloading
		     spinner and the detail variables need but the art slots do not. -->
		<propertyGroup name="widgetWeather">
			<var name="isWeather">
				<value condition="widgetPath~weather-widget">True</value>
				<value>False</value>
			</var>
		</propertyGroup>
	</propertyGroups>

	<variables>
		<variable name="widgetDetails">
			<!-- Selected, not loaded -->
			<value condition="$PROPERTY[widgetFocus] + Integer.IsEqual(Container(10$PARENT[index]0$PROPERTY[index]).NumItems,0)">$LOCALIZE[20186]...</value>
			<!-- Weather -->
			<value condition="$PROPERTY[widgetFocus] + $PROPERTY[isWeather]">$INFO[$PROPERTY[widgetItem].Property(outlook)][CR][LIGHT]$INFO[Window(Weather).Property(Location)][/LIGHT]</value>
			<!-- Movies -->
			<value condition="String.IsEqual($PROPERTY[widgetItem].DBTYPE,movie) + $PROPERTY[widgetFocus] + !String.IsEmpty($PROPERTY[widgetItem].Year)">$INFO[$PROPERTY[widgetItem].Title][CR][LIGHT]$INFO[$PROPERTY[widgetItem].Year]$INFO[$PROPERTY[widgetItem].Genre(comma), &#8226; ,][/LIGHT]</value>
			<value condition="String.IsEqual($PROPERTY[widgetItem].DBTYPE,movie) + $PROPERTY[widgetFocus] + String.IsEmpty($PROPERTY[widgetItem].Year)">$INFO[$PROPERTY[widgetItem].Title][CR][LIGHT]$INFO[$PROPERTY[widgetItem].Genre(comma)][/LIGHT]</value>
			<!-- Movie sets -->
			<value condition="String.IsEqual($PROPERTY[widgetItem].DBTYPE,set) + $PROPERTY[widgetFocus]">$LOCALIZE[20457]</value>
			<!-- TV Shows: the season, watched and episode phrases are fragments below -->
			<value condition="String.IsEqual($PROPERTY[widgetItem].DBTYPE,tvshow) + $PROPERTY[widgetFocus] + Integer.IsEqual($PROPERTY[widgetItem].Property(TotalSeasons),0)">$INFO[$PROPERTY[widgetItem].TVShowTitle][CR][LIGHT]$INFO[$PROPERTY[widgetItem].Year,, &#8226; ]$INFO[$PROPERTY[widgetItem].Property(TotalSeasons),, $LOCALIZE[36905]][/LIGHT]</value>
			<value condition="String.IsEqual($PROPERTY[widgetItem].DBTYPE,tvshow) + $PROPERTY[widgetFocus]">$INFO[$PROPERTY[widgetItem].TVShowTitle][CR][LIGHT]$INFO[$PROPERTY[widgetItem].Year,, &#8226; ]$VAR[widgetTVSeasons]$VAR[widgetTVWatched]$VAR[widgetTVEpisodes][/LIGHT]</value>
			<!-- Episodes Widget: the SxxExx code and the date line are fragments below. The row only
			     applies when one of the two dates is set, as the enumerated rows did. -->
			<value condition="String.IsEqual($PROPERTY[widgetItem].DBTYPE,episode) + $PROPERTY[widgetFocus] + [!String.IsEmpty($PROPERTY[widgetItem].Premiered) | !String.IsEmpty($PROPERTY[widgetItem].Date)]">$VAR[widgetSeasonEpisode] &#8226; $INFO[$PROPERTY[widgetItem].Title][CR][LIGHT]$INFO[$PROPERTY[widgetItem].TVShowTitle]$VAR[widgetEpisodeDate][/LIGHT]</value>
			<!-- PVR Channels. The now and next line is a fragment, so the row does not need a
			     second copy of itself for channels that have no programme information. -->
			<value condition="$PROPERTY[widgetFocus] + !String.IsEmpty($PROPERTY[widgetItem].ChannelName) + !String.StartsWith($PROPERTY[widgetItem].Path,pvr://recordings/tv/) + [String.StartsWith($PROPERTY[widgetItem].Path,pvr://channels/) | String.StartsWith($PROPERTY[widgetItem].Path,pvr://timers/)]">$INFO[$PROPERTY[widgetItem].ChannelName]$INFO[$PROPERTY[widgetItem].ChannelNumberLabel, (,)]$VAR[widgetPVRNowNext]</value>
			<!-- PVR Recordings -->
			<value condition="$PROPERTY[widgetFocus] + !String.IsEmpty($PROPERTY[widgetItem].StartTime) + String.StartsWith($PROPERTY[widgetItem].Path,pvr://recordings/tv/)">$INFO[$PROPERTY[widgetItem].Label][CR][LIGHT]$INFO[$PROPERTY[widgetItem].StartDate]$INFO[$PROPERTY[widgetItem].StartTime, - ,][/LIGHT]</value>
			<!-- Songs/Music videos -->
			<value condition="[String.IsEqual($PROPERTY[widgetItem].DBTYPE,song) | String.IsEqual($PROPERTY[widgetItem].DBTYPE,musicvideo)] + $PROPERTY[widgetFocus] + !String.IsEmpty($PROPERTY[widgetItem].Artist) + !String.IsEmpty($PROPERTY[widgetItem].Album)">$INFO[$PROPERTY[widgetItem].TrackNumber,,. ]$INFO[$PROPERTY[widgetItem].Title][CR][LIGHT]$INFO[$PROPERTY[widgetItem].Artist]$INFO[$PROPERTY[widgetItem].Album, &#8226; ,]$INFO[$PROPERTY[widgetItem].Year, &#8226; ,][/LIGHT]</value>
			<!-- Albums -->
			<value condition="String.IsEqual($PROPERTY[widgetItem].DBTYPE,album) + $PROPERTY[widgetFocus] + !String.IsEmpty($PROPERTY[widgetItem].Artist) + !String.IsEmpty($PROPERTY[widgetItem].Album)">$INFO[$PROPERTY[widgetItem].Album][CR][LIGHT]$INFO[$PROPERTY[widgetItem].Artist]$INFO[$PROPERTY[widgetItem].Year, &#8226; ,][/LIGHT]</value>
			<!-- Others -->
			<value condition="$PROPERTY[widgetFocus]">$INFO[$PROPERTY[widgetItem].Label]</value>
		</variable>
		<!-- The three phrases the TV show row is built from. Each is empty unless its own
		     count is set, so the row needs no cross product of season, episode and watched. -->
		<variable name="widgetTVSeasons">
			<value condition="$PROPERTY[widgetFocus] + Integer.IsEqual($PROPERTY[widgetItem].Property(TotalSeasons),1)">$INFO[$PROPERTY[widgetItem].Property(TotalSeasons),, $LOCALIZE[36904] &#8226; ]</value>
			<value condition="$PROPERTY[widgetFocus]">$INFO[$PROPERTY[widgetItem].Property(TotalSeasons),, $LOCALIZE[36905] &#8226; ]</value>
		</variable>
		<!-- Guarded on the episode count too: a show with no episodes shows no watched tally,
		     which the enumerated rows achieved by simply not having a watched variant. -->
		<variable name="widgetTVWatched">
			<value condition="$PROPERTY[widgetFocus] + Integer.IsGreater($PROPERTY[widgetItem].Property(WatchedEpisodes),0) + Integer.IsGreater($PROPERTY[widgetItem].Property(TotalEpisodes),0)">$INFO[$PROPERTY[widgetItem].Property(WatchedEpisodes),$LOCALIZE[16102]: , $LOCALIZE[1443] ]</value>
		</variable>
		<variable name="widgetTVEpisodes">
			<value condition="$PROPERTY[widgetFocus] + Integer.IsEqual($PROPERTY[widgetItem].Property(TotalEpisodes),1)">$INFO[$PROPERTY[widgetItem].Property(TotalEpisodes),, $LOCALIZE[36906]]</value>
			<value condition="$PROPERTY[widgetFocus]">$INFO[$PROPERTY[widgetItem].Property(TotalEpisodes),, $LOCALIZE[36907]]</value>
		</variable>
		<!-- SxxExx, zero padded below ten. Specials carry no season, so they show the episode
		     name instead; that row must come first because the padding rows assume a season. -->
		<variable name="widgetSeasonEpisode">
			<value condition="$PROPERTY[widgetFocus] + String.IsEqual($PROPERTY[widgetItem].Season,0)">$INFO[$PROPERTY[widgetItem].Episode,[UPPERCASE],[/UPPERCASE]]</value>
			<value condition="$PROPERTY[widgetFocus] + !Integer.IsGreater($PROPERTY[widgetItem].Season,9) + !Integer.IsGreater($PROPERTY[widgetItem].Episode,9)">S0$INFO[$PROPERTY[widgetItem].Season]E0$INFO[$PROPERTY[widgetItem].Episode]</value>
			<value condition="$PROPERTY[widgetFocus] + !Integer.IsGreater($PROPERTY[widgetItem].Season,9)">S0$INFO[$PROPERTY[widgetItem].Season]E$INFO[$PROPERTY[widgetItem].Episode]</value>
			<value condition="$PROPERTY[widgetFocus] + !Integer.IsGreater($PROPERTY[widgetItem].Episode,9)">S$INFO[$PROPERTY[widgetItem].Season]E0$INFO[$PROPERTY[widgetItem].Episode]</value>
			<value condition="$PROPERTY[widgetFocus]">S$INFO[$PROPERTY[widgetItem].Season]E$INFO[$PROPERTY[widgetItem].Episode]</value>
		</variable>
		<variable name="widgetEpisodeDate">
			<value condition="$PROPERTY[widgetFocus] + !String.IsEmpty($PROPERTY[widgetItem].Premiered)">$INFO[$PROPERTY[widgetItem].Premiered, &#8226; $LOCALIZE[20416]: ,]</value>
			<value condition="$PROPERTY[widgetFocus] + !String.IsEmpty($PROPERTY[widgetItem].Date)">$INFO[$PROPERTY[widgetItem].Date, &#8226; $LOCALIZE[570]: ,]</value>
		</variable>
		<!-- The now and next line for a PVR channel, empty when the channel reports no
		     programme or only the placeholder string. -->
		<variable name="widgetPVRNowNext">
			<value condition="$PROPERTY[widgetFocus] + !String.IsEmpty($PROPERTY[widgetItem].Title) + !String.IsEqual($PROPERTY[widgetItem].Title,$LOCALIZE[19055])">[CR][LIGHT]$INFO[$PROPERTY[widgetItem].Title] ($INFO[$PROPERTY[widgetItem].StartTime] - $INFO[$PROPERTY[widgetItem].EndTime])[CR]$INFO[$PROPERTY[widgetItem].NextTitle] ($INFO[$PROPERTY[widgetItem].NextStartTime] - $INFO[$PROPERTY[widgetItem].NextEndTime])[/LIGHT]</value>
		</variable>
		<variable name="widgetWeatherBackground">
			<value condition="Window.Is(Home) + $PROPERTY[widgetFocus] + $PROPERTY[isWeather]">$INFO[Skin.String(weatherFanart.path)]$INFO[$PROPERTY[widgetItem].Property(weatherFanart)]$INFO[Skin.String(weatherFanart.ext)]</value>
		</variable>
		<variableGroup name="widgetVars">
			<variable content="widgetDetails" />
			<variable content="widgetTVSeasons" />
			<variable content="widgetTVWatched" />
			<variable content="widgetTVEpisodes" />
			<variable content="widgetSeasonEpisode" />
			<variable content="widgetEpisodeDate" />
			<variable content="widgetPVRNowNext" />
			<variable content="widgetWeatherBackground" />
		</variableGroup>
	</variables>

	<!-- Hidden list tracking the current widget, the buttons that move through it,
	     and the widget heading. One block per main menu item that has widgets. -->
	<template include="widgetControl" menu="mainmenu">
		<controls>
			<!-- List used to control movement between widgets -->
			<control type="list" id="1000$PROPERTY[index]">
				<left>1300</left>
				<top>-10000</top>
				<width>100</width>
				<height>300</height>
				<scrolltime>200</scrolltime>
				<skinshortcuts>visibility</skinshortcuts>
				<defaultcontrol>1</defaultcontrol>
				<itemlayout width="100" height="100">
					<control type="label">
						<width>100</width>
						<height>100</height>
						<textcolor>$VAR[TextColorNF]</textcolor>
						<label>$INFO[ListItem.Label]</label>
					</control>
				</itemlayout>
				<focusedlayout width="100" height="100">
					<control type="label">
						<width>100</width>
						<height>100</height>
						<label>$INFO[ListItem.Label]</label>
					</control>
				</focusedlayout>
				<content>
					<skinshortcuts insert="controlItems" />
				</content>
			</control>

			<!-- Buttons used to move between widgets -->
			<control type="button" id="9005">
				<description>Select previous widget</description>
				<left>500</left>
				<top>-10000</top>
				<skinshortcuts>visibility</skinshortcuts>
				<label>Previous</label>
				<skinshortcuts insert="onclickPrevious" />
				<onfocus>SetProperty(changeWidget-1000$PROPERTY[index],True,10000)</onfocus>
				<onfocus>AlarmClock(changeWidgetTimer,SetProperty(changeWidget-1000$PROPERTY[index],False,10000),00:03,silent)</onfocus>
				<onfocus>Control.Move(1000$PROPERTY[index],-1)</onfocus>
			</control>
			<control type="button" id="9006">
				<description>Select current widget</description>
				<left>700</left>
				<top>-10000</top>
				<skinshortcuts>visibility</skinshortcuts>
				<label>Current</label>
				<skinshortcuts insert="onclickCurrent" />
				<onfocus condition="Integer.IsEqual(Container(1000$PROPERTY[index]).NumItems,0) | [String.IsEmpty(Container(10$PROPERTY[index]01).ListItem.Property(outlook)) | String.IsEqual(Container(10$PROPERTY[index]01).ListItem.Property(outlook),$LOCALIZE[10006])] + String.IsEqual(Container(9000).ListItem.Property(submenuVisibility),weather)">Control.SetFocus(9000)</onfocus>
			</control>
			<control type="button" id="9007">
				<description>Select next widget</description>
				<left>900</left>
				<top>-10000</top>
				<skinshortcuts>visibility</skinshortcuts>
				<label>Next</label>
				<skinshortcuts insert="onclickNext" />
				<onfocus>SetProperty(changeWidget-1000$PROPERTY[index],True,10000)</onfocus>
				<onfocus>AlarmClock(changeWidgetTimer,SetProperty(changeWidget-1000$PROPERTY[index],False,10000),00:03,silent)</onfocus>
				<onfocus>Control.Move(1000$PROPERTY[index],1)</onfocus>
			</control>

			<!-- Widget heading/details -->
			<control type="group">
				<skinshortcuts>visibility</skinshortcuts>
				<visible>Integer.IsGreater(Container(1000$PROPERTY[index]).NumItems,0)</visible>
				<include content="widgetHeading">
					<param name="container">1000$PROPERTY[index]</param>
					<param name="container2">10$PROPERTY[index]01</param>
				</include>
			</control>

		</controls>
	</template>

	<template items="controlItems" source="widgets">
		<controls>
			<item id="$PROPERTY[index]">
				<label>$PROPERTY[widgetLabel]</label>
				<visible>[Integer.IsGreater(Container(10$PARENT[index]0$PROPERTY[index]).NumItems,0) | Container(10$PARENT[index]0$PROPERTY[index]).IsUpdating] + !String.IsEqual(Container(9000).ListItem.Property(submenuVisibility),weather) | !String.IsEmpty(Container(10$PARENT[index]0$PROPERTY[index]).ListItem.Property(outlook)) + !String.IsEqual(Container(10$PARENT[index]0$PROPERTY[index]).ListItem.Property(outlook),$LOCALIZE[10006]) + String.IsEqual(Container(9000).ListItem.Property(submenuVisibility),weather)</visible>
				<property name="widgetID">$PARENT[index]-$PROPERTY[index]</property>
				<property name="widgetContainer">10$PARENT[index]0$PROPERTY[index]</property>
			</item>
		</controls>
	</template>

	<template items="onclickPrevious" source="widgets">
		<controls>
			<onfocus condition="String.IsEqual(Container(1000$PARENT[index]).ListItem(-1).Property(widgetID),$PARENT[index]-$PROPERTY[index])">Control.SetFocus(10$PARENT[index]0$PROPERTY[index])</onfocus>
		</controls>
	</template>

	<template items="onclickCurrent" source="widgets">
		<controls>
			<onfocus condition="String.IsEqual(Container(1000$PARENT[index]).ListItem.Property(widgetID),$PARENT[index]-$PROPERTY[index])">Control.SetFocus(10$PARENT[index]0$PROPERTY[index])</onfocus>
		</controls>
	</template>

	<template items="onclickNext" source="widgets">
		<controls>
			<onfocus condition="String.IsEqual(Container(1000$PARENT[index]).ListItem(1).Property(widgetID),$PARENT[index]-$PROPERTY[index])">Control.SetFocus(10$PARENT[index]0$PROPERTY[index])</onfocus>
		</controls>
	</template>

	<!-- The widgets themselves -->
	<template include="vertical" menu="mainmenu">
		<controls>
			<skinshortcuts insert="weatherWidget" />
			<skinshortcuts insert="libraryWidget" />
			<skinshortcuts insert="widgetVariables" />
		</controls>
	</template>

	<template items="weatherWidget" source="widgets" filter="widgetPath~weather-widget">
		<controls>
			<control type="list" id="10$PARENT[index]0$PROPERTY[index]">
				<viewtype label="$LOCALIZE[535]">list</viewtype>
				<orientation>horizontal</orientation>
				<defaultcontrol always="true">0</defaultcontrol>
				<scrolltime tween="sine" easing="out">240</scrolltime>

				<!-- Widget layout -->
				<include>widgetLayout-weather</include>

				<!-- Widget oncontrol -->
				<include content="widgetOnControl">
					<param name="container">1000$PARENT[index]</param>
				</include>
				
				<!-- Widget layout slide -->
				<include content="widgetLayoutSlide-weather">
					<param name="container">10$PARENT[index]0$PROPERTY[index]</param>
				</include>

				<!-- Widget animation -->
				<include content="widgetAnimation">
					<param name="container1">1000$PARENT[index]</param>
					<param name="container2">$PARENT[index]-$PROPERTY[index]</param>
				</include>

				<itemlayout width="203" height="306">
					<control type="group">
						<control type="label">
							<top>2</top>
							<width>203</width>
							<height>33</height>
							<font>Font33</font>
							<align>center</align>
							<textcolor>$VAR[TextColorNF]</textcolor>
							<label>$INFO[ListItem.Label]</label>
						</control>
						<control type="image">
							<left>21</left>
							<top>60</top>
							<width>162</width>
							<height>197</height>
							<texture background="true" colordiffuse="$VAR[DiffusePosterNF]">$INFO[ListItem.Icon]</texture>
							<aspectratio align="center">keep</aspectratio>
							<visible>!Skin.HasSetting(weatherIcons.multi)</visible>
						</control>
						<control type="multiimage">
							<left>21</left>
							<top>60</top>
							<width>162</width>
							<height>197</height>
							<imagepath>$INFO[ListItem.Property(weatherIconMulti)]</imagepath>
							<colordiffuse>$VAR[DiffusePosterNF]</colordiffuse>
							<timeperimage>200</timeperimage>
							<aspectratio align="center">keep</aspectratio>
							<visible>Skin.HasSetting(weatherIcons.multi)</visible>
						</control>
						<control type="label">
							<top>281</top>
							<width>203</width>
							<height>33</height>
							<font>Font33</font>
							<align>center</align>
							<textcolor>$VAR[TextColorNF]</textcolor>
							<label>$INFO[ListItem.Label2]</label>
						</control>
					</control>
				</itemlayout>

				<focusedlayout width="203" height="306">
					<control type="group">
						<animation effect="zoom" start="100" end="120" center="auto" time="300" tween="back" easing="out" reversible="false">Focus</animation>
						<animation effect="fade" start="100" end="0" time="0" reversible="false" condition="Control.HasFocus(9000)">Conditional</animation>
						<animation effect="fade" start="100" end="0" time="0" reversible="false">Unfocus</animation>
						<control type="group">
							<visible>!System.HasActiveModalDialog + Control.HasFocus(10$PARENT[index]0$PROPERTY[index])</visible>
							<control type="image">
								<left>21</left>
								<top>60</top>
								<width>162</width>
								<height>197</height>
								<texture background="true">$INFO[ListItem.Icon]</texture>
								<aspectratio align="center">keep</aspectratio>
								<visible>!Skin.HasSetting(weatherIcons.multi)</visible>
							</control>
							<control type="multiimage">
								<left>21</left>
								<top>60</top>
								<width>162</width>
								<height>197</height>
								<imagepath>$INFO[ListItem.Property(weatherIconMulti)]</imagepath>
								<timeperimage>200</timeperimage>
								<aspectratio align="center">keep</aspectratio>
								<visible>Skin.HasSetting(weatherIcons.multi)</visible>
							</control>
						</control>
						<control type="group">
							<visible>System.HasActiveModalDialog | !Control.HasFocus(10$PARENT[index]0$PROPERTY[index])</visible>
							<control type="image">
								<left>21</left>
								<top>60</top>
								<width>162</width>
								<height>197</height>
								<texture background="true" colordiffuse="$VAR[DiffusePosterNF]">$INFO[ListItem.Icon]</texture>
								<aspectratio align="center">keep</aspectratio>
								<visible>!Skin.HasSetting(weatherIcons.multi)</visible>
							</control>
							<control type="multiimage">
								<left>21</left>
								<top>60</top>
								<width>162</width>
								<height>197</height>
								<imagepath>$INFO[ListItem.Property(weatherIconMulti)]</imagepath>
							<colordiffuse>$VAR[DiffusePosterNF]</colordiffuse>
								<timeperimage>200</timeperimage>
								<aspectratio align="center">keep</aspectratio>
								<visible>Skin.HasSetting(weatherIcons.multi)</visible>
							</control>
						</control>
					</control>
					<control type="group">
						<animation effect="fade" start="100" end="0" time="0" reversible="false" condition="Control.HasFocus(9000)">Conditional</animation>
						<animation effect="fade" start="100" end="0" time="0" reversible="false">Unfocus</animation>
						<control type="group">
							<visible>!System.HasActiveModalDialog + Control.HasFocus(10$PARENT[index]0$PROPERTY[index])</visible>
							<control type="label">
								<top>2</top>
								<width>203</width>
								<height>33</height>
								<font>Font33</font>
								<align>center</align>
								<label>$INFO[ListItem.Label]</label>
								<textcolor>$VAR[TextColorFO]</textcolor>
							</control>
							<control type="label">
								<top>281</top>
								<width>203</width>
								<height>33</height>
								<font>Font33</font>
								<align>center</align>
								<textcolor>$VAR[TextColorFO]</textcolor>
								<label>$INFO[ListItem.Label2]</label>
							</control>
						</control>
						<control type="group">
							<visible>System.HasActiveModalDialog | !Control.HasFocus(10$PARENT[index]0$PROPERTY[index])</visible>
							<control type="label">
								<top>2</top>
								<width>203</width>
								<height>33</height>
								<font>Font33</font>
