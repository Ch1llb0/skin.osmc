								<param name="left">$MATH[(imageWidthFocus - imageWidthNoFocus) / 2]</param>
								<param name="width">$PROPERTY[imageWidthNoFocus]</param>
								<param name="height">$PROPERTY[imageHeightNoFocus]</param>
								<param name="fallback">$PROPERTY[artFallback]</param>
								<param name="art">$INFO[ListItem.$PROPERTY[widgetArt]]</param>
								<param name="visible">![$PROPERTY[secondaryVisibility]]</param>
							</include>
							<include content="$PROPERTY[secondaryArt]">
								<description>Fallback art</description>
								<param name="left">$MATH[(imageWidthFocus - imageWidthNoFocus) / 2]</param>
								<param name="width">$PROPERTY[imageWidthNoFocus]</param>
								<param name="height">$PROPERTY[imageHeightNoFocus]</param>
								<param name="fallback">$PROPERTY[artFallback]</param>
								<param name="art">$INFO[ListItem.$PROPERTY[widgetFallbackArt]]</param>
								<param name="visible">[ $PROPERTY[secondaryVisibility] ] + ![ $PROPERTY[fallbackVisibility] ]</param>
							</include>
							<include content="widget-image">
								<description>Catch-all art</description>
								<param name="left">$MATH[(imageWidthFocus - imageWidthNoFocus) / 2]</param>
								<param name="width">$PROPERTY[imageWidthNoFocus]</param>
								<param name="height">$PROPERTY[imageHeightNoFocus]</param>
								<param name="fallback">$PROPERTY[artFallback]</param>
								<param name="art">$INFO[ListItem.Icon]</param>
								<param name="visible">[ $PROPERTY[secondaryVisibility] ] + [ $PROPERTY[fallbackVisibility] ]</param>
							</include>
							
							<include content="widgetOverlayBar">
								<param name="left">$MATH[(imageWidthFocus - imageWidthNoFocus) / 2]</param>
								<param name="width">$PROPERTY[imageWidthNoFocus]</param>
								<param name="height">$PROPERTY[overlayHeight]</param>
								<param name="centerleft">$MATH[imageWidthNoFocus / 2]</param>
								<param name="slide">$PROPERTY[overlaySlide]</param>
							</include>
						</control>
						<control type="group">
							<visible>System.HasActiveModalDialog | !Control.HasFocus(10$PARENT[index]0$PROPERTY[index])</visible>
							<include content="$PROPERTY[primaryArt]">
								<description>Primary art</description>
								<param name="left">$MATH[(imageWidthFocus - imageWidthNoFocus) / 2]</param>
								<param name="width">$PROPERTY[imageWidthNoFocus]</param>
								<param name="height">$PROPERTY[imageHeightNoFocus]</param>
								<param name="colordiffuse">$VAR[DiffusePosterNF]</param>
								<param name="fallback">$PROPERTY[artFallback]</param>
								<param name="art">$INFO[ListItem.$PROPERTY[widgetArt]]</param>
								<param name="visible">![$PROPERTY[secondaryVisibility]]</param>
							</include>
							<include content="$PROPERTY[secondaryArt]">
								<description>Fallback art</description>
								<param name="left">$MATH[(imageWidthFocus - imageWidthNoFocus) / 2]</param>
								<param name="width">$PROPERTY[imageWidthNoFocus]</param>
								<param name="height">$PROPERTY[imageHeightNoFocus]</param>
								<param name="colordiffuse">$VAR[DiffusePosterNF]</param>
								<param name="fallback">$PROPERTY[artFallback]</param>
								<param name="art">$INFO[ListItem.$PROPERTY[widgetFallbackArt]]</param>
								<param name="visible">[ $PROPERTY[secondaryVisibility] ] + ![ $PROPERTY[fallbackVisibility] ]</param>
							</include>
							<include content="widget-image">
								<description>Catch-all art</description>
								<param name="left">$MATH[(imageWidthFocus - imageWidthNoFocus) / 2]</param>
								<param name="width">$PROPERTY[imageWidthNoFocus]</param>
								<param name="colordiffuse">$VAR[DiffusePosterNF]</param>
								<param name="height">$PROPERTY[imageHeightNoFocus]</param>
								<param name="fallback">$PROPERTY[artFallback]</param>
								<param name="art">$INFO[ListItem.Icon]</param>
								<param name="visible">[ $PROPERTY[secondaryVisibility] ] + [ $PROPERTY[fallbackVisibility] ]</param>
							</include>
							
							<include content="widgetOverlayBar">
								<param name="left">$MATH[(imageWidthFocus - imageWidthNoFocus) / 2]</param>
								<param name="width">$PROPERTY[imageWidthNoFocus]</param>
								<param name="height">$PROPERTY[overlayHeight]</param>
								<param name="centerleft">$MATH[imageWidthNoFocus / 2]</param>
								<param name="slide">$PROPERTY[overlaySlide]</param>
								<param name="colordiffuse">$VAR[DiffusePosterNF]</param>
							</include>
						</control>
					</control>
					<control type="group">
						<animation effect="fade" start="100" end="0" time="0" reversible="false">Focus</animation>
						<include content="$PROPERTY[primaryArt]">
							<description>Primary art</description>
							<param name="left">$MATH[(imageWidthFocus - imageWidthNoFocus) / 2]</param>
							<param name="width">$PROPERTY[imageWidthNoFocus]</param>
							<param name="height">$PROPERTY[imageHeightNoFocus]</param>
							<param name="colordiffuse">$VAR[DiffusePosterNF]</param>
							<param name="fallback">$PROPERTY[artFallback]</param>
							<param name="art">$INFO[ListItem.$PROPERTY[widgetArt]]</param>
							<param name="visible">![$PROPERTY[secondaryVisibility]]</param>
						</include>
						<include content="$PROPERTY[secondaryArt]">
							<description>Fallback art</description>
							<param name="left">$MATH[(imageWidthFocus - imageWidthNoFocus) / 2]</param>
							<param name="width">$PROPERTY[imageWidthNoFocus]</param>
							<param name="height">$PROPERTY[imageHeightNoFocus]</param>
							<param name="colordiffuse">$VAR[DiffusePosterNF]</param>
							<param name="fallback">$PROPERTY[artFallback]</param>
							<param name="art">$INFO[ListItem.$PROPERTY[widgetFallbackArt]]</param>
							<param name="visible">[ $PROPERTY[secondaryVisibility] ] + ![ $PROPERTY[fallbackVisibility] ]</param>
						</include>
						<include content="widget-image">
							<description>Catch-all art</description>
							<param name="left">$MATH[(imageWidthFocus - imageWidthNoFocus) / 2]</param>
							<param name="width">$PROPERTY[imageWidthNoFocus]</param>
