				<content limit="$PROPERTY[widgetLimit]" sortby="$PROPERTY[widgetSortBy]" sortorder="$PROPERTY[widgetSortOrder]" target="$PROPERTY[widgetTarget]" browse="never">$PROPERTY[widgetPath]</content>
			</control>
