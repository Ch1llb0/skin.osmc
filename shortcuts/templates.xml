	<template items="libraryWidget" source="widgets" filter="widgetPath + !widgetPath~weather-widget">
		<propertyGroup content="widgetArtwork" />
		<preset content="widgetLayout" />
		<controls>
			<control type="list" id="10$PARENT[index]0$PROPERTY[index]">
				<viewtype label="$LOCALIZE[535]">list</viewtype>
				<orientation>horizontal</orientation>
				<defaultcontrol always="true">0</defaultcontrol>
				<scrolltime tween="sine" easing="out">240</scrolltime>

				<!-- Widget layout -->
				<include>widgetLayout-$PROPERTY[layout]</include>

				<!-- Widget oncontrol -->
				<include content="widgetOnControl">
					<param name="container">1000$PARENT[index]</param>
				</include>
				
				<!-- Widget layout slide -->
				<include content="widgetLayoutSlide-$PROPERTY[layout]">
					<param name="container">10$PARENT[index]0$PROPERTY[index]</param>
				</include>

				<!-- Widget animation -->
				<include content="widgetAnimation">
					<param name="container1">1000$PARENT[index]</param>
					<param name="container2">$PARENT[index]-$PROPERTY[index]</param>
				</include>
				
				<!-- Widget onclick -->
				<onclick condition="String.IsEqual(ListItem.DBTYPE,album) + !String.StartsWith(ListItem.FileNameAndPath,plugin://)">$VAR[WidgetOnClickAlbum]</onclick>
				<onclick condition="String.IsEqual(ListItem.DBTYPE,tvshow) + !String.StartsWith(ListItem.FileNameAndPath,plugin://)">$VAR[WidgetOnClickTVShow]</onclick>
				<onclick condition="String.IsEqual(ListItem.DBTYPE,set) + !String.StartsWith(ListItem.FileNameAndPath,plugin://)">$VAR[WidgetOnClickMovieSet]</onclick>

				<itemlayout width="$PROPERTY[layoutWidth]" height="$PROPERTY[layoutHeight]">
					<include content="$PROPERTY[primaryArt]">
						<description>Primary art</description>
						<param name="left">$MATH[(imageWidthFocus - imageWidthNoFocus) / 2]</param>
						<param name="width">$PROPERTY[imageWidthNoFocus]</param>
						<param name="height">$PROPERTY[imageHeightNoFocus]</param>
						<param name="colordiffuse">$VAR[DiffusePosterNF]</param>
						<param name="fallback">$PROPERTY[artFallback]</param>
						<param name="art">$INFO[ListItem.$PROPERTY[widgetArt]]</param>
						<param name="visible">![$PROPERTY[secondaryVisibility]]</param>
					</include>
					<include content="$PROPERTY[secondaryArt]">
						<description>Fallback art</description>
						<param name="left">$MATH[(imageWidthFocus - imageWidthNoFocus) / 2]</param>
						<param name="width">$PROPERTY[imageWidthNoFocus]</param>
						<param name="height">$PROPERTY[imageHeightNoFocus]</param>
						<param name="colordiffuse">$VAR[DiffusePosterNF]</param>
						<param name="fallback">$PROPERTY[artFallback]</param>
						<param name="art">$INFO[ListItem.$PROPERTY[widgetFallbackArt]]</param>
						<param name="visible">[ $PROPERTY[secondaryVisibility] ] + ![ $PROPERTY[fallbackVisibility] ]</param>
					</include>
					<include content="widget-image">
						<description>Catch-all art</description>
						<param name="left">$MATH[(imageWidthFocus - imageWidthNoFocus) / 2]</param>
						<param name="width">$PROPERTY[imageWidthNoFocus]</param>
						<param name="height">$PROPERTY[imageHeightNoFocus]</param>
						<param name="colordiffuse">$VAR[DiffusePosterNF]</param>
						<param name="fallback">$PROPERTY[artFallback]</param>
						<param name="art">$INFO[ListItem.Icon]</param>
						<param name="visible">[ $PROPERTY[secondaryVisibility] ] + [ $PROPERTY[fallbackVisibility] ]</param>
					</include>
					
					<include content="widgetOverlayBar">
						<param name="left">$MATH[(imageWidthFocus - imageWidthNoFocus) / 2]</param>
						<param name="width">$PROPERTY[imageWidthNoFocus]</param>
						<param name="height">$PROPERTY[overlayHeight]</param>
						<param name="centerleft">$MATH[imageWidthNoFocus / 2]</param>
						<param name="slide">$PROPERTY[overlaySlide]</param>
						<param name="colordiffuse">$VAR[DiffusePosterNF]</param>
					</include>
				</itemlayout>

				<focusedlayout width="$PROPERTY[layoutWidth]" height="$PROPERTY[layoutHeight]">
					<control type="group">
						<animation effect="zoom" start="100" end="111" center="$MATH[imageWidthFocus / 2],$PROPERTY[imageHeightFocus]" time="300" tween="back" easing="out" reversible="false">Focus</animation>
						<animation effect="fade" start="100" end="0" time="0" reversible="false" condition="Control.HasFocus(9000)">Conditional</animation>
						<animation effect="fade" start="100" end="0" time="0" reversible="false">Unfocus</animation>
						<control type="group">
							<visible>!System.HasActiveModalDialog + Control.HasFocus(10$PARENT[index]0$PROPERTY[index])</visible>
