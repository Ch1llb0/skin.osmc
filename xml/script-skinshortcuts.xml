<?xml version="1.0" encoding="UTF-8"?>
<window>
	<!-- script-skinshortcuts -->
	<defaultcontrol always="true">304</defaultcontrol>
	<onload>SetProperty(scriptdialog,script-skinshortcuts.xml,10000)</onload>
	<onunload>ClearProperty(scriptdialog,10000)</onunload>
	
	<!-- Scroll reset -->
	<include>ResetScroll</include>

	<controls>
	
		<!-- The two move buttons are the arrows drawn at the right of the row the list is on,
		     and each goes when there is nowhere to move: no up on the first entry, no down on
		     the last. Disabled, they are stepped over, so right from the list lands on
		     whichever of them is left. -->
		<!-- Control ids come from three places, and only the first is fixed:
		     211, 301-305, 307, 311, 313, 401, 405   Skin Shortcuts built-ins, the add-on decides these
		     309, 310, 502-504, 601-603              bound in shortcuts/properties.xml <buttons>
		     406                                     subdialog trigger, bound in shortcuts/menus.xml
		     1, 60, 80, 210, 314, 9000, 9001         this skin's own
		     Renumbering anything in the middle two groups means editing shortcuts/ as well. -->
	
		<!-- Black background image -->
		<control type="image">
			<include>FullscreenDimensions</include>
			<texture background="true">common/white.png</texture>
			<colordiffuse>FF000000</colordiffuse>
			<aspectratio>scale</aspectratio>
			<include>DialogZoomAnimation</include>
			<include>DialogBackgroundDepth</include>
		</control>
		<!-- Color -->
		<control type="image">
			<include>FullscreenDimensions</include>
			<texture background="true">common/white.png</texture>
			<colordiffuse>$VAR[SolidBackgroundColor]</colordiffuse>
			<visible>String.IsEqual(Skin.String(BackgroundDefaultImage),no) | String.IsEqual(Skin.String(BackgroundSingleImage),solid)</visible>
			<aspectratio>scale</aspectratio>
			<include>DialogZoomAnimation</include>
			<include>DialogBackgroundDepth</include>
		</control>
		
		<!-- Single background image -->
		<control type="image">
			<include>FullscreenDimensions</include>
			<texture background="true">$VAR[OSMCBackgroundImage]</texture>
			<visible>[String.IsEqual(Skin.String(BackgroundDefaultImage),yes) | String.IsEqual(Skin.String(BackgroundSingleImage),yes) | String.IsEqual(Skin.String(BackgroundSingleImage),no) + String.IsEmpty(Skin.String(CustomBackgroundFolder))] + String.IsEmpty(Container(211).ListItem.Property(backgroundPath))</visible>
			<aspectratio>scale</aspectratio>
			<include>DialogZoomAnimation</include>
			<include>DialogBackgroundDepth</include>
		</control>
		<!-- Multiple background images -->
		<control type="multiimage">
			<include>FullscreenDimensions</include>
			<imagepath background="true">$VAR[OSMCBackgroundImage]</imagepath>
			<visible>String.IsEqual(Skin.String(BackgroundSingleImage),no) + !String.IsEmpty(Skin.String(CustomBackgroundFolder)) + String.IsEmpty(Container(211).ListItem.Property(backgroundPath))</visible>
			<aspectratio>scale</aspectratio>
			<include>CustomBackgroundFolderDuration</include>
			<fadetime>2000</fadetime>
			<randomize>true</randomize>
			<loop>yes</loop>
			<include>DialogZoomAnimation</include>
			<include>DialogBackgroundDepth</include>
		</control>
		
		<!-- Single individual background image -->
		<control type="image">
			<include>FullscreenDimensions</include>
			<texture background="true">$INFO[Container(211).ListItem.Property(backgroundPath)]</texture>
			<visible>String.IsEqual(Container(211).ListItem.Property(backgroundType),browse)</visible>
			<aspectratio>scale</aspectratio>
			<animation effect="fade" start="0" end="100" time="200" delay="70">Visible</animation>
			<animation effect="fade" start="100" end="0" time="200">Hidden</animation>
			<include>DialogZoomAnimation</include>
			<include>DialogBackgroundDepth</include>
		</control>
		<!-- Multiple individual background images -->
		<control type="multiimage">
			<include>FullscreenDimensions</include>
			<imagepath background="true">$INFO[Container(211).ListItem.Property(backgroundPath)]</imagepath>
			<visible>String.IsEqual(Container(211).ListItem.Property(backgroundType),multi)</visible>
			<aspectratio>scale</aspectratio>
			<include>IndividualBackgroundFolderDuration</include>
			<fadetime>2000</fadetime>
			<randomize>true</randomize>
			<loop>yes</loop>
			<animation effect="fade" start="0" end="100" time="200" delay="70">Visible</animation>
			<animation effect="fade" start="100" end="0" time="200">Hidden</animation>
			<include>DialogZoomAnimation</include>
			<include>DialogBackgroundDepth</include>
		</control>
		
		<!-- Fanart -->
		<control type="image">
			<include>FullscreenDimensions</include>
			<texture background="true">$INFO[ListItem.Art(fanart)]</texture>
			<aspectratio>scale</aspectratio>
			<fadetime>400</fadetime>
			<visible>!Skin.HasSetting(HideFanart) + !String.IsEmpty(ListItem.Art(fanart))</visible>
			<include>DialogBackgroundDepth</include>
		</control>
		
		<!-- Overlay -->
		<control type="group">
			<include>FullscreenDimensions</include>
			<animation type="WindowOpen">
				<effect type="zoom" start="70" end="100" center="auto" tween="back" easing="inout" time="300" />
				<effect type="fade" start="0" end="100" time="100" />
			</animation>
			<animation type="WindowClose">
				<effect type="zoom" start="100" end="70" center="auto" time="300" />
				<effect type="fade" start="100" end="0" time="100" delay="200" />
			</animation>
			<control type="image">
				<include>BackgroundOverlayDialog1</include>
				<texture background="true">$VAR[Background1]</texture>
				<aspectratio>scale</aspectratio>
				<colordiffuse>$VAR[BackgroundColor]</colordiffuse>
				<include>DialogBackgroundDepth</include>
			</control>
			<control type="image">
				<include condition="!Skin.HasSetting(BackgroundOverlayStyle)">BackgroundOverlayDialog2</include>
				<include condition="Skin.HasSetting(BackgroundOverlayStyle)">BackgroundOverlayDialog3</include>
				<texture background="true">$VAR[BackgroundOverlayStyle]</texture>
				<aspectratio>scale</aspectratio>
				<colordiffuse>$VAR[BackgroundColor]</colordiffuse>
				<include>DialogBackgroundDepth</include>
			</control>
			<control type="image">
				<include>BackgroundOverlayDialog4</include>
				<texture background="true">$VAR[Background2]</texture>
				<aspectratio>scale</aspectratio>
				<colordiffuse>$VAR[BackgroundColor]</colordiffuse>
				<include>DialogBackgroundDepth</include>
				<visible>Skin.HasSetting(BackgroundOverlayStyle)</visible>
			</control>
		</control>

		<control type="group">
			<include>DialogDepth</include>
		
			<!-- Animation -->
			<include>DialogZoomAnimation</include>
			
			<!-- Heading -->
			<include content="Time">
				<param name="heading">$VAR[skinshortcuts-window]</param>
				<param name="secondary">False</param>
			</include>

			<!-- The two move buttons are the arrows drawn at the right of the row the list is
			     on, and each one is only there while it has somewhere to move to: no up on
			     the first row, no down on the last. Neither is ever disabled. A control that
			     turns itself off is no good as a target, because a skin condition is read
			     once a frame and focus is set inside the same frame as the move that would
			     free it, so the focus would be refused and land nowhere. Instead the two
			     step over each other, and every move that spends the button under the cursor
			     hands it to the other: a click that lands its own row at an end, and a step
			     that arrives at one - including the step that wraps the list right round. -->
			<!-- Move down -->
			<control type="button" id="304">
				<left>-1000</left>
				<top>-1000</top>
				<width>1</width>
				<height>1</height>
				<onleft>60</onleft>
				<onright condition="!Integer.IsEqual(Container(211).CurrentItem,1)">303</onright>
				<onright condition="Integer.IsEqual(Container(211).CurrentItem,1)">80</onright>
				<onclick condition="String.IsEmpty(Container(211).ListItemNoWrap(2).Label)">Control.SetFocus(303)</onclick>
				<onup>Control.Move(211,-1)</onup>
				<onup condition="Integer.IsEqual(Container(211).CurrentItem,1)">Control.SetFocus(303)</onup>
				<ondown>Control.Move(211,1)</ondown>
				<ondown condition="String.IsEmpty(Container(211).ListItemNoWrap(2).Label) + !Integer.IsEqual(Container(211).CurrentItem,Container(211).NumItems)">Control.SetFocus(303)</ondown>
			</control>
			
			<!-- Move up -->
			<control type="button" id="303">
				<left>-1000</left>
				<top>-1000</top>
				<width>1</width>
				<height>1</height>
				<onleft condition="!Integer.IsEqual(Container(211).CurrentItem,Container(211).NumItems)">304</onleft>
				<onleft condition="Integer.IsEqual(Container(211).CurrentItem,Container(211).NumItems)">60</onleft>
				<onright>80</onright>
				<onclick condition="String.IsEmpty(Container(211).ListItemNoWrap(-2).Label)">Control.SetFocus(304)</onclick>
				<onup>Control.Move(211,-1)</onup>
				<onup condition="Integer.IsEqual(Container(211).CurrentItem,2)">Control.SetFocus(304)</onup>
				<ondown>Control.Move(211,1)</ondown>
				<ondown condition="Integer.IsEqual(Container(211).CurrentItem,Container(211).NumItems)">Control.SetFocus(304)</ondown>
			</control>
			
			<!-- Left list -->
			<control type="list" id="211">
				<include>script-skinshortcuts_coords1</include>
				<enable>false</enable>
				<onleft>60</onleft>
				<onright>304</onright>
				<onup>211</onup>
				<ondown>211</ondown>
				<pagecontrol>60</pagecontrol>
				<scrolltime tween="sine" easing="out">240</scrolltime>

				<include>script-skinshortcuts_coords2</include>

				<include>script-skinshortcuts_coords3</include>

			</control>
			
			<!-- Scrollbar (Left list) -->
			<control type="scrollbar" id="60">
				<include>script-skinshortcuts_coords4</include>
				<onleft>9001</onleft>
				<onright condition="!Integer.IsEqual(Container(211).CurrentItem,Container(211).NumItems)">304</onright>
				<onright condition="Integer.IsEqual(Container(211).CurrentItem,Container(211).NumItems)">303</onright>
				<showonepage>false</showonepage>
				<orientation>vertical</orientation>
				<colordiffuse>$VAR[OverlayColorNF]</colordiffuse>
				<texturesliderbackground border="0,5,0,5">common/ScrollBackground.png</texturesliderbackground>
				<texturesliderbar border="0,5,0,5" colordiffuse="$VAR[OverlayColorNF]">common/ScrollbarGripNF.png</texturesliderbar>
				<texturesliderbarfocus border="0,5,0,5" colordiffuse="$VAR[OverlayColorFO]">common/ScrollbarGripFO.png</texturesliderbarfocus>
				<textureslidernib></textureslidernib>
				<textureslidernibfocus></textureslidernibfocus>
				<visible>!Skin.HasSetting(Scrollbars)</visible>
			</control>

			<!-- Right grouplist -->
			<control type="grouplist" id="9000">
				<include>script-skinshortcuts_coords5</include>
				<itemgap>0</itemgap>
				<onleft>80</onleft>
				<onright>9001</onright>
				<onup>9000</onup>
				<ondown>9000</ondown>
				<orientation>vertical</orientation>
				<usecontrolcoords>true</usecontrolcoords>
				<pagecontrol>80</pagecontrol>
				<scrolltime tween="sine" easing="out">240</scrolltime>

				<!-- Heading -->
				<control type="label" id="1">
					<include>script-skinshortcuts_coords6</include>
					<label>$INFO[Container(211).ListItem.Label]</label>
					<align>center</align>
					<scroll>True</scroll>
					<scrollspeed>55</scrollspeed>
					<textcolor>$VAR[TextColorNF]</textcolor>
				</control>
				
				<!-- Change shortcut -->
				<control type="button" id="401">
					<include>script-skinshortcuts_coords6</include>
					<label>$ADDON[script.skinshortcuts 32048]</label>
					<visible>!$EXP[SkinShortcutsWidgetMenu]</visible>
				</control>
				<!-- Select widget -->
				<control type="button" id="309">
					<include>script-skinshortcuts_coords6</include>
					<label>$ADDON[script.skinshortcuts 32044]</label>
					<visible>$EXP[SkinShortcutsWidgetMenu]</visible>
				</control>
				
				
				<!-- Change label -->
				<control type="button" id="305">
					<include>script-skinshortcuts_coords6</include>
					<label>  -  $LOCALIZE[528]</label>
				</control>
				
				<!-- Change action -->
				<control type="button" id="307">
					<include>script-skinshortcuts_coords6</include>
					<label>  -  $ADDON[script.skinshortcuts 32027]</label>
					<label2>$INFO[Container(211).ListItem.Property(action)]</label2>
					<visible>!$EXP[SkinShortcutsWidgetMenu]</visible>
				</control>
				
				<!-- Edit background -->
				<control type="button" id="310">
					<include>script-skinshortcuts_coords6</include>
					<label>  -  $ADDON[script.skinshortcuts 32045]</label>
					<label2>$INFO[Container(211).ListItem.Property(backgroundLabel)]</label2>
					<disabledcolor>$VAR[DisabledColor]</disabledcolor>
					<visible>$EXP[SkinShortcutsMainMenu]</visible>
				</control>
				
				<!-- Edit background duration -->
				<control type="button" id="210">
					<include>script-skinshortcuts_coords6</include>
					<label>  -  $LOCALIZE[31137]</label>
					<label2>$INFO[Skin.String(IndividualBackgroundFolderDuration)]</label2>
					<include>OpenIndividualBackgroundFolderDuration</include>
					<disabledcolor>$VAR[DisabledColor]</disabledcolor>
					<visible>$EXP[SkinShortcutsMainMenu]</visible>
				</control>

				<!-- Edit submenu -->
				<control type="button" id="405">
					<include>script-skinshortcuts_coords6</include>
					<label>$ADDON[script.skinshortcuts 32072]</label>
					<visible>$EXP[SkinShortcutsMainMenu]</visible>
				</control>

				<!-- Manage widgets -->
				<control type="button" id="406">
					<include>script-skinshortcuts_coords6</include>
					<label>$LOCALIZE[31095]</label>
					<visible>$EXP[SkinShortcutsMainMenu]</visible>
				</control>

				<!-- Change layout -->
				<control type="button" id="601">
					<include>script-skinshortcuts_coords6</include>
					<label>  -  $LOCALIZE[31172]</label>
					<label2>$INFO[Container(211).ListItem.Property(layoutLabel)]</label2>
					<enable>$EXP[SkinShortcutsWidgetEditable]</enable>
					<disabledcolor>$VAR[DisabledColor]</disabledcolor>
					<visible>$EXP[SkinShortcutsWidgetMenu]</visible>
				</control>

				<!-- Change artwork -->
				<control type="button" id="602">
					<include>script-skinshortcuts_coords6</include>
					<label>  -  $LOCALIZE[31033]</label>
					<label2>$INFO[Container(211).ListItem.Property(widgetArtLabel)]</label2>
					<enable>$EXP[SkinShortcutsWidgetEditable]</enable>
					<disabledcolor>$VAR[DisabledColor]</disabledcolor>
					<visible>$EXP[SkinShortcutsWidgetMenu]</visible>
				</control>
				
				<!-- Fallback artwork -->
				<control type="button" id="603">
					<include>script-skinshortcuts_coords6</include>
					<label>  -  $LOCALIZE[31029]</label>
					<label2>$INFO[Container(211).ListItem.Property(widgetFallbackArtLabel)]</label2>
					<enable>$EXP[SkinShortcutsWidgetEditable]</enable>
					<disabledcolor>$VAR[DisabledColor]</disabledcolor>
					<visible>$EXP[SkinShortcutsWidgetMenu]</visible>
				</control>

				<!-- Widget sort by -->
				<control type="button" id="502">
					<include>script-skinshortcuts_coords6</include>
					<label>  -  $LOCALIZE[31175]</label>
					<label2>$VAR[WidgetSortByLabel]</label2>
					<enable>$EXP[SkinShortcutsWidgetEditable]</enable>
					<disabledcolor>$VAR[DisabledColor]</disabledcolor>
					<visible>$EXP[SkinShortcutsWidgetMenu]</visible>
				</control>
				
				<!-- Widget sort direction -->
				<control type="button" id="503">
					<include>script-skinshortcuts_coords6</include>
					<label>  -  $LOCALIZE[31176]</label>
					<label2>$VAR[WidgetSortOrderLabel]</label2>
					<enable>$EXP[SkinShortcutsWidgetEditable]</enable>
					<disabledcolor>$VAR[DisabledColor]</disabledcolor>
					<visible>$EXP[SkinShortcutsWidgetMenu]</visible>
				</control>
				
				<!-- Widget limit items -->
				<control type="button" id="504">
					<include>script-skinshortcuts_coords6</include>
					<label>  -  $LOCALIZE[31177]</label>
					<label2>$VAR[WidgetLimitLabel]</label2>
					<enable>$EXP[SkinShortcutsWidgetEditable]</enable>
					<disabledcolor>$VAR[DisabledColor]</disabledcolor>
					<visible>$EXP[SkinShortcutsWidgetMenu]</visible>
				</control>

				<!-- Hide -->
				<control type="radiobutton" id="313">
					<include>script-skinshortcuts_coords7</include>
					<label>$LOCALIZE[31161]</label>
					<selected>String.IsEqual(Container(211).ListItem.Property(skinshortcuts-disabled),True)</selected>
					<enable>!String.IsEqual(Container(211).ListItem.Property(skinshortcuts-isRequired),True)</enable>
					<disabledcolor>$VAR[DisabledColor]</disabledcolor>
				</control>

				<!-- Delete -->
				<control type="button" id="302">
					<include>script-skinshortcuts_coords6</include>
					<label>$ADDON[script.skinshortcuts 32001]</label>
					<enable>!String.IsEqual(Container(211).ListItem.Property(skinshortcuts-isRequired),True)</enable>
					<disabledcolor>$VAR[DisabledColor]</disabledcolor>
				</control>
				
			</control>
			
			<!-- Scrollbar (Right grouplist) -->
			<control type="scrollbar" id="80">
				<include>script-skinshortcuts_coords8</include>
				<onright>9000</onright>
				<onleft condition="!Integer.IsEqual(Container(211).CurrentItem,1)">303</onleft>
				<onleft condition="Integer.IsEqual(Container(211).CurrentItem,1)">304</onleft>
				<showonepage>false</showonepage>
				<orientation>vertical</orientation>
				<colordiffuse>$VAR[OverlayColorNF]</colordiffuse>
				<texturesliderbackground border="0,5,0,5">common/ScrollBackground.png</texturesliderbackground>
				<texturesliderbar border="0,5,0,5" colordiffuse="$VAR[OverlayColorNF]">common/ScrollbarGripNF.png</texturesliderbar>
				<texturesliderbarfocus border="0,5,0,5" colordiffuse="$VAR[OverlayColorFO]">common/ScrollbarGripFO.png</texturesliderbarfocus>
				<textureslidernib></textureslidernib>
				<textureslidernibfocus></textureslidernibfocus>
				<visible>!Skin.HasSetting(Scrollbars)</visible>
			</control>

			<!-- Settings description -->
			<control type="fadelabel">
				<include>script-skinshortcuts_coords9</include>
				<font>Font27</font>
				<scrollspeed>44</scrollspeed>
				<label>$VAR[SkinShortcutsExplanation1]</label>
			</control>

			<!-- Buttons -->
			<control type="grouplist" id="9001">
				<include>DialogButtons</include>
				<orientation>horizontal</orientation>
				<align>center</align>
				<itemgap>30</itemgap>
				<onup>9000</onup>
				<defaultcontrol always="true">0</defaultcontrol>
				<visible>!Window.IsVisible(1106)</visible>
				<include>VisibleFadeAnimation</include>


				<!-- Add item -->
				<control type="button" id="301">
					<width>auto</width>
					<label>$ADDON[script.skinshortcuts 32000]</label>
				</control>

				<!-- Restore -->
				<control type="button" id="311">
					<width>auto</width>
					<label>$ADDON[script.skinshortcuts 32028]</label>
					<enable>!String.IsEmpty(Window.Property(skinshortcuts-hasdeleted))</enable>
					<disabledcolor>$VAR[DisabledColor]</disabledcolor>
				</control>

				<!-- Help -->
				<control type="button" id="314">
					<label>10043</label>
					<width>auto</width>
					<onclick condition="$EXP[SkinShortcutsWidgetMenu]">SetProperty(Window,Widgetmenu,1106)</onclick>
					<onclick condition="!$EXP[SkinShortcutsMainMenu] + !$EXP[SkinShortcutsWidgetMenu]">SetProperty(Window,Submenu,1106)</onclick>
					<onclick condition="$EXP[SkinShortcutsMainMenu]">SetProperty(Window,Mainmenu,1106)</onclick>
					<onclick>ActivateWindow(1106)</onclick>
				</control>
			
			</control>
			
			<!-- Button indicator -->
			<include content="dialogButtonIndicator">
				<param name="visibility">!ControlGroup(9001).HasFocus + !Window.IsVisible(shutdownmenu)</param>
			</include>

		</control>

		<!-- Hidden controls -->
		<include>MaskingBars</include>

	</controls>

</window>
