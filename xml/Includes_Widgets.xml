	<!-- The status bar along the bottom edge of a widget poster: the bar itself, the three
	     PVR state icons, and the watched overlay. Recording, timer and reminder are mutually
	     exclusive, so each slides aside by the same amount when a watched overlay shares the
	     bar. Called four times per widget - item layout, and the three focused variants -
	     which differ only in whether the poster is dimmed, hence the colordiffuse default. -->
	<include name="widgetOverlayBar">
		<param name="colordiffuse">FFFFFFFF</param>
		<param name="textcolor">$VAR[TextColorFO]</param>
		<param name="scroll">False</param>
		<definition>
			<control type="group">
				<left>$PARAM[left]</left>
				<bottom>0</bottom>
				<width>$PARAM[width]</width>
				<height>$PARAM[height]</height>
				<control type="image">
					<texture background="true">views/OverlayBottomBar.png</texture>
					<colordiffuse>$PARAM[colordiffuse]</colordiffuse>
					<visible>$EXP[StatusOverlayVisible] | ListItem.IsRecording | [ListItem.HasTimer | ListItem.HasTimerSchedule] + !ListItem.IsRecording | Skin.HasSetting(ArtworkTitles) + !ListItem.IsParentFolder</visible>
				</control>
				<control type="label">
					<left>$PARAM[pad]</left>
					<right>$PARAM[pad]</right>
					<height>$PARAM[height]</height>
					<font>$PARAM[font]</font>
					<aligny>center</aligny>
					<textcolor>$PARAM[textcolor]</textcolor>
					<label>$INFO[ListItem.Label]</label>
					<scroll>$PARAM[scroll]</scroll>
					<scrollspeed>$PARAM[scrollspeed]</scrollspeed>
					<visible>Skin.HasSetting(ArtworkTitles) + !ListItem.IsParentFolder + !$EXP[WidgetBadgeVisible]</visible>
				</control>
				<control type="label">
					<left>$PARAM[pad]</left>
					<right>$PARAM[titleright]</right>
					<height>$PARAM[height]</height>
					<font>$PARAM[font]</font>
					<aligny>center</aligny>
					<textcolor>$PARAM[textcolor]</textcolor>
					<label>$INFO[ListItem.Label]</label>
					<scroll>$PARAM[scroll]</scroll>
					<scrollspeed>$PARAM[scrollspeed]</scrollspeed>
					<visible>Skin.HasSetting(ArtworkTitles) + !ListItem.IsParentFolder + $EXP[WidgetBadgeVisible]</visible>
				</control>
				<control type="group">
					<animation effect="slide" end="$PARAM[badgeshift],0" time="0" reversible="false" condition="Skin.HasSetting(ArtworkTitles)">Conditional</animation>
					<control type="image">
						<width>$PARAM[height]</width>
						<centerleft>$PARAM[centerleft]</centerleft>
						<texture background="true">pvr/Recording.png</texture>
						<colordiffuse>$PARAM[colordiffuse]</colordiffuse>
						<visible>ListItem.IsRecording</visible>
						<animation effect="slide" end="-$PARAM[slide],0" time="0" reversible="false" condition="$EXP[IsWatchedOrResumed] + $EXP[WatchedStatusVisible]">Conditional</animation>
					</control>
					<control type="image">
						<width>$PARAM[height]</width>
						<centerleft>$PARAM[centerleft]</centerleft>
						<texture background="true">pvr/Timer.png</texture>
						<colordiffuse>$PARAM[colordiffuse]</colordiffuse>
						<visible>[ListItem.HasTimer | ListItem.HasTimerSchedule] + !ListItem.IsRecording + !ListItem.HasReminder + !ListItem.HasReminderRule</visible>
						<animation effect="slide" end="-$PARAM[slide],0" time="0" reversible="false" condition="$EXP[IsWatchedOrResumed] + $EXP[WatchedStatusVisible]">Conditional</animation>
					</control>
					<control type="image">
						<width>$PARAM[height]</width>
						<centerleft>$PARAM[centerleft]</centerleft>
						<texture background="true">pvr/Reminder.png</texture>
						<colordiffuse>$PARAM[colordiffuse]</colordiffuse>
						<visible>[ListItem.HasReminder | ListItem.HasReminderRule] + !ListItem.IsRecording</visible>
						<animation effect="slide" end="-$PARAM[slide],0" time="0" reversible="false" condition="$EXP[IsWatchedOrResumed] + $EXP[WatchedStatusVisible]">Conditional</animation>
					</control>
					<control type="image">
						<width>$PARAM[height]</width>
						<centerleft>$PARAM[centerleft]</centerleft>
						<texture background="true">$VAR[StatusOverlayWide]</texture>
						<colordiffuse>$PARAM[colordiffuse]</colordiffuse>
						<animation effect="slide" end="$PARAM[slide],0" time="0" reversible="false" condition="ListItem.IsRecording | [ListItem.HasTimer | ListItem.HasTimerSchedule] + !ListItem.IsRecording + !ListItem.HasReminder + !ListItem.HasReminderRule | [ListItem.HasReminder | ListItem.HasReminderRule] + !ListItem.IsRecording">Conditional</animation>
					</control>
				</control>
			</control>
		</definition>
	</include>

	<!-- The up and down column beside the widgets: the same arrows the home menu uses for more
	     menu items, at the same top and bottom and the same 120 in from the screen edge, this
	     time the right one. Both are always drawn - the caller shows the column only when there
	     is more than one screenful, and which end you are at is not what it reports. -->
	<include name="widgetIndicators">
		<definition>
			<control type="group">
				<include>widgetindicators_coords</include>
				<animation type="Visible">
					<effect type="fade" start="0" end="100" time="400" delay="400" />
				</animation>
				<animation type="Hidden">
					<effect type="fade" start="100" end="0" time="400" />
				</animation>
				<control type="image">
					<left>0</left>
					<top>0</top>
					<width>30</width>
					<height>16</height>
					<texture colordiffuse="$VAR[OverlayColorNF]">up.png</texture>
				</control>
				<control type="image">
					<left>0</left>
					<bottom>0</bottom>
					<width>30</width>
					<height>16</height>
					<texture colordiffuse="$VAR[OverlayColorNF]">down.png</texture>
				</control>
			</control>
		</definition>
	</include>

	<!-- Widget layout -->
	<include name="widgetLayout-weather">
		<include>widgetLayout-weather-OSMC</include>
	</include>
	
	<include name="widgetLayout-tall">
		<include>widgetLayout-tall-OSMC</include>
	</include>

	<include name="widgetLayout-wide">
		<include>widgetLayout-wide-OSMC</include>
	</include>
	
	<include name="widgetLayout-square">
		<include>widgetLayout-square-OSMC</include>
	</include>
	
	<include name="widgetLayout-square-small">
		<include>widgetLayout-square-small-OSMC</include>
	</include>

	<!-- Widget on control -->
	<include name="widgetOnControl">
		<param name="menu">none</param>
		<definition>
			<include content="widgetOnControl-OSMC">
				<param name="container">$PARAM[container]</param>
				<param name="menu">$PARAM[menu]</param>
			</include>
		</definition>
	</include>
	
	<include name="widgetOnControl-OSMC">
		<!-- The second widget of an odd list sits on two pages, so up and down there turn the
		     page rather than move: 9008 back to the page it shares with the first widget, 9009
		     on to the page it shares with the third. menu defaults to a name no menu has, so a
		     fallback built before two row support, which passes none, never takes that branch. -->
		<param name="menu">none</param>
		<definition>
			<onleft>9000</onleft>
			<onback>9000</onback>
			<onup condition="Integer.IsGreater(Container($PARAM[container]).NumItems,1) + ![$EXP[TwoRowWidgets] + Integer.IsOdd(Container($PARAM[container]).NumItems) + String.IsEqual(Container($PARAM[container]).ListItem.Property(widgetID),$PARAM[menu]-2) + String.IsEqual(Window(Home).Property(widgetUp-$PARAM[container]),True)]">9005</onup>
			<onup condition="Integer.IsGreater(Container($PARAM[container]).NumItems,1) + [$EXP[TwoRowWidgets] + Integer.IsOdd(Container($PARAM[container]).NumItems) + String.IsEqual(Container($PARAM[container]).ListItem.Property(widgetID),$PARAM[menu]-2) + String.IsEqual(Window(Home).Property(widgetUp-$PARAM[container]),True)]">9008</onup>
			<ondown condition="Integer.IsGreater(Container($PARAM[container]).NumItems,1) + ![$EXP[TwoRowWidgets] + Integer.IsOdd(Container($PARAM[container]).NumItems) + String.IsEqual(Container($PARAM[container]).ListItem.Property(widgetID),$PARAM[menu]-2) + ![String.IsEqual(Window(Home).Property(widgetUp-$PARAM[container]),True)]]">9007</ondown>
			<ondown condition="Integer.IsGreater(Container($PARAM[container]).NumItems,1) + [$EXP[TwoRowWidgets] + Integer.IsOdd(Container($PARAM[container]).NumItems) + String.IsEqual(Container($PARAM[container]).ListItem.Property(widgetID),$PARAM[menu]-2) + ![String.IsEqual(Window(Home).Property(widgetUp-$PARAM[container]),True)]]">9009</ondown>
			<onright>noop</onright>
		</definition>
	</include>
	
	<!-- Widget Layout Slide -->
	<include name="widgetLayoutSlide-weather">
		<definition>
			<include content="widgetLayoutSlide-weather-OSMC">
				<param name="container">$PARAM[container]</param>
			</include>
		</definition>
	</include>
	
	<include name="widgetLayoutSlide-tall">
		<!-- tworow defaults to False, so a fallback built before two row support, which passes
		     nothing, keeps right aligning short widgets by the one widget slot. -->
		<param name="tworow">False</param>
		<definition>
			<include content="widgetLayoutSlide-tall-OSMC">
				<param name="container">$PARAM[container]</param>
				<param name="tworow">$PARAM[tworow]</param>
			</include>
		</definition>
	</include>
	
	<include name="widgetLayoutSlide-wide">
		<!-- tworow defaults to False, so a fallback built before two row support, which passes
		     nothing, keeps right aligning short widgets by the one widget slot. -->
		<param name="tworow">False</param>
		<definition>
			<include content="widgetLayoutSlide-wide-OSMC">
				<param name="container">$PARAM[container]</param>
				<param name="tworow">$PARAM[tworow]</param>
			</include>
		</definition>
	</include>
	
	<include name="widgetLayoutSlide-square">
		<!-- tworow defaults to False, so a fallback built before two row support, which passes
		     nothing, keeps right aligning short widgets by the one widget slot. -->
		<param name="tworow">False</param>
		<definition>
			<include content="widgetLayoutSlide-square-OSMC">
				<param name="container">$PARAM[container]</param>
				<param name="tworow">$PARAM[tworow]</param>
			</include>
