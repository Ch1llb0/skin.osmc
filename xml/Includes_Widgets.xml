	</include>
	
	<include name="widgetLayoutSlide-square-small">
		<!-- tworow defaults to False, so a fallback built before two row support, which passes
		     nothing, keeps right aligning short widgets by the one widget slot. -->
		<param name="tworow">False</param>
		<definition>
			<include content="widgetLayoutSlide-square-small-OSMC">
				<param name="container">$PARAM[container]</param>
				<param name="tworow">$PARAM[tworow]</param>
			</include>
		</definition>
	</include>
	
	<!-- Widget Animation -->
	<include name="widgetAnimation">
		<param name="twoup">False</param>
		<param name="shown">False</param>
		<definition>
			<include content="widgetAnimation-OSMC">
				<param name="container1">$PARAM[container1]</param>
				<param name="container2">$PARAM[container2]</param>
				<param name="twoup">$PARAM[twoup]</param>
				<param name="shown">$PARAM[shown]</param>
			</include>
		</definition>
	</include>

	<include name="widgetAnimation-OSMC">
		<!-- twoup defaults to False, so a fallback built before two row support, which passes
		     neither twoup nor page, keeps selecting on the widget alone. -->
		<param name="twoup">False</param>
		<param name="shown">False</param>
		<definition>
			<!-- Visible/Hidden (group) animation -->
			<animation type="Conditional" condition="Control.IsVisible($PARAM[container1])">
				<effect type="fade" start="0" end="100" time="400" delay="400" />
			</animation>
			<animation type="Conditional" condition="!Control.IsVisible($PARAM[container1])">
				<effect type="fade" start="100" end="0" time="400" />
			</animation>

			<!-- Selected/deselected widget animation. With two on screen the pair sharing a page
			     fades together, so paging crossfades exactly as moving between single widgets does. -->
			<animation type="Conditional" condition="[![$PARAM[twoup]] + String.IsEqual(Container($PARAM[container1]).ListItem.Property(widgetID),$PARAM[container2])] | [[$PARAM[twoup]] + [$PARAM[shown]]]">
				<effect type="fade" start="0" end="100" time="400" delay="400" />
			</animation>
			<animation type="Conditional" condition="![[![$PARAM[twoup]] + String.IsEqual(Container($PARAM[container1]).ListItem.Property(widgetID),$PARAM[container2])] | [[$PARAM[twoup]] + [$PARAM[shown]]]]">
				<effect type="fade" start="100" end="0" time="400" />
			</animation>
		</definition>
	</include>

	<!-- Widget heading/details -->
	<include name="widgetHeading">
		<definition>
			<include content="widgetHeading-OSMC">
				<param name="container">$PARAM[container]</param>
				<param name="container2">$PARAM[container2]</param>
			</include>
		</definition>
	</include>

	<include name="widgetHeading-OSMC">
		<definition>
			<include>widgetHeading-OSMC_coords</include>
			<include content="widgetHeading-content">
				<param name="container">$PARAM[container]</param>
				<param name="container2">$PARAM[container2]</param>
			</include>
		</definition>
	</include>

	<include name="widgetHeading-content">
		<definition>
			<animation type="Visible">
				<effect type="fade" start="0" end="100" time="400" delay="400" />
			</animation>
			<animation type="Hidden">
				<effect type="fade" start="100" end="0" time="400" />
			</animation>
			<animation type="Conditional" condition="!String.IsEmpty(Container($PARAM[container2]).ListItem.Property(outlook)) + !String.IsEqual(Container($PARAM[container2]).ListItem.Property(outlook),$LOCALIZE[10006]) + String.IsEqual(Container(9000).ListItem.Property(submenuVisibility),weather)">
				<effect type="fade" start="0" end="100" time="400" delay="400"  />
			</animation>
			<animation type="Conditional" condition="[String.IsEmpty(Container($PARAM[container2]).ListItem.Property(outlook)) | String.IsEqual(Container($PARAM[container2]).ListItem.Property(outlook),$LOCALIZE[10006])] + String.IsEqual(Container(9000).ListItem.Property(submenuVisibility),weather)">
				<effect type="fade" start="100" end="0" time="400" />
			</animation>

			<!-- Widget has focus -->
			<control type="grouplist">
				<orientation>vertical</orientation>
				<usecontrolcoords>true</usecontrolcoords>
				
				<!-- Widget heading -->
				<control type="label">
					<include>widgetdetails_coords</include>
					<height>46</height>
					<font>Font33</font>
					<align>right</align>
					<aligny>top</aligny>
					<visible>Integer.IsEqual(Container($PARAM[container]).NumItems,1)</visible>
					<label>$INFO[Container($PARAM[container]).ListItem.Label]</label>
					<textcolor>$VAR[TextColorNF]</textcolor>
					<scroll>True</scroll>
					<scrollspeed>55</scrollspeed>
				</control>
				
				<!-- Indicators + Widget heading -->
				<control type="grouplist">
					<height>46</height>
					<include>widgetdetails_coords</include>
					<itemgap>10</itemgap>
					<align>right</align>
					<orientation>horizontal</orientation>
					<usecontrolcoords>true</usecontrolcoords>
					<visible>Integer.IsGreater(Container($PARAM[container]).NumItems,1)</visible>
					<control type="label">
						<width>auto</width>
						<height>46</height>
						<font>Font33</font>
						<align>right</align>
						<aligny>top</aligny>
						<label>$INFO[Container($PARAM[container]).ListItem.Label]</label>
						<textcolor>$VAR[TextColorNF]</textcolor>
					</control>
				</control>

				<!-- Widget details -->
				<control type="textbox">
					<include>widgetdetails_coords</include>
					<!-- Three rows of 39.75 for Font33, the most the text runs to: a PVR channel's
					     name over its now and next line. One widget on screen has the room for all
					     three, so nothing has to scroll here; two rows share the two they can fit. -->
					<height>120</height>
					<autoscroll time="3000" delay="4000" repeat="4000" />
					<font>Font33</font>
					<align>right</align>
					<aligny>top</aligny>
					<label>$INFO[Control.GetLabel(9988)]</label>
					<textcolor>$VAR[TextColorFO]</textcolor>
					<visible>!String.IsEmpty(Control.GetLabel(9988))</visible>
					<animation effect="fade" start="0" end="100" time="200">Visible</animation>
					<animation effect="fade" start="100" end="0" time="200">Hidden</animation>
				</control>
				
				<control type="label" id="9988">
					<font></font>
					<label>$VAR[widgetDetails]</label>
				</control>

				<!-- Carries the focused weather widget's fanart so widgetBackground can test it
				     for emptiness; Kodi cannot do that on a $VAR directly. Empty, and absent
				     altogether outside Home, in every other case. -->
				<control type="label" id="9987">
					<font></font>
					<label>$VAR[widgetWeatherBackground]</label>
				</control>
				
			</control>
			
			<!-- Reloading indicator -->
			<control type="group">
				<include>widgetreloadingindicator_coords</include>
				<include>skinshortcuts-template-reloading</include>
			</control>
			
		</definition>
	</include>

</includes>