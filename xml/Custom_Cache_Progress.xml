<?xml version="1.0" encoding="UTF-8"?>
<window type="dialog" id="1100">
	<!-- customcachedialog -->
	<visible>Player.Caching</visible>
	<onload>SetProperty(isCaching,False,10000)</onload>
	<onload>AlarmClock(isCachingTimer,SetProperty(isCaching,True,10000),00:01,silent)</onload>
	<onunload>SetProperty(isCaching,False,10000)</onunload>
	<onunload>CancelAlarm(isCachingTimer,silent)</onunload>
	
	<!-- Scroll reset -->
	<include>ResetScroll</include>
	<zorder>100</zorder>
	
	<controls>
	
		<control type="group">
			<include>NotificationDepth</include>
			<visible>Player.Caching + String.IsEqual(Window(10000).Property(isCaching),True)</visible>
			<animation effect="slide" start="570,0" time="200">Visible</animation>
			<animation effect="slide" end="0,0" time="200">Hidden</animation>

			<!-- Background -->
			<control type="image">
				<include>Custom_Cache_Progress_coords1</include>
				<texture border="8" colordiffuse="$VAR[MenuOSDColor]">$VAR[MenuOSDPanel]</texture>
			</control>

			<!-- Heading -->
			<control type="label">
				<include>Custom_Cache_Progress_coords2</include>
				<align>left</align>
				<scroll>True</scroll>
				<scrollspeed>44</scrollspeed>
				<font>Font27</font>
				<label>$LOCALIZE[15107]</label>
			</control>

			<!-- Progress -->
			<control type="progress">
				<include>Custom_Cache_Progress_coords3</include>
				<info>Player.Progress</info>
				<texturebg border="6,0,6,0" colordiffuse="$VAR[OverlayColorFO]">common/PanelProgressBack.png</texturebg>
				<midtexture border="6,0,0,0" colordiffuse="$VAR[OverlayColorFO]">common/PanelProgressBar.png</midtexture>
			</control>
			<control type="progress">
				<include>Custom_Cache_Progress_coords3</include>
				<midtexture border="6,0,0,0" colordiffuse="$VAR[OSDCacheColor]">common/PanelProgressBar.png</midtexture>
				<info>Player.ProgressCache</info>
			</control>
			
		</control>

	</controls>

</window>