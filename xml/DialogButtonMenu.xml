<?xml version="1.0" encoding="UTF-8"?>
<window>
	<!-- shutdownmenu -->
	<defaultcontrol always="true">7000</defaultcontrol>
	<onload>Dialog.Close(1110)</onload>
	
	<!-- Scroll reset -->
	<include>ResetScroll</include>

	<controls>
	
		<control type="group">
			<include>NotificationDepth</include>

			<!-- Background image -->
			<include>DialogFadeBackgroundImage</include>
			<control type="group">
				<animation effect="slide" start="-460,0" time="200">WindowOpen</animation>
				<animation effect="slide" end="-460,0" time="200">WindowClose</animation>

				<control type="image">
					<include>DialogButtonMenu_coords1</include>
					<texture colordiffuse="$VAR[MenuOSDColor]">$VAR[MenuOSDBackground]</texture>
				</control>

				<control type="grouplist" id="7000">
					<include>DialogButtonMenu_coords2</include>
					<onright>Close</onright>
					<onleft>Close</onleft>
					<orientation>vertical</orientation>
					<itemgap>0</itemgap>

					<include content="SubMenuAnimation">
						<param name="containerID">7000</param>
					</include>

					<include content="DialogRowButton">
						<param name="id">600</param>
						<param name="coords">DialogButtonMenu_coords3</param>
						<param name="label">13012</param>
						<param name="onclick">Quit</param>
						<param name="visible">System.ShowExitButton</param>
					</include>
					
					<include content="DialogRowButton">
						<param name="id">601</param>
						<param name="coords">DialogButtonMenu_coords3</param>
						<param name="label">13016</param>
						<param name="onclick">Powerdown</param>
						<param name="visible">System.CanPowerDown</param>
					</include>
					
					<include content="DialogRowButton">
						<param name="id">602</param>
						<param name="coords">DialogButtonMenu_coords3</param>
						<param name="label">13011</param>
						<param name="onclick">Suspend</param>
						<param name="visible">System.CanSuspend</param>
					</include>
					
					<include content="DialogRowButton">
						<param name="id">603</param>
						<param name="coords">DialogButtonMenu_coords3</param>
						<param name="label">13010</param>
						<param name="onclick">Hibernate</param>
						<param name="visible">System.CanHibernate</param>
					</include>
					
					<include content="DialogRowButton">
						<param name="id">604</param>
						<param name="coords">DialogButtonMenu_coords3</param>
						<param name="label">13013</param>
						<param name="onclick">Reset</param>
						<param name="visible">System.CanReboot</param>
					</include>
					
					<control type="button" id="605">
						<include>DialogButtonMenu_coords3</include>
						<label>$LOCALIZE[20126] $INFO[system.profilename]</label>
						<texturefocus colordiffuse="$VAR[buttonfocus]">common/focus52c.png</texturefocus>
						<onclick>dialog.close(all,true)</onclick>
						<onclick>System.LogOff</onclick>
						<align>center</align>
						<visible>System.HasLoginScreen | Integer.IsGreater(System.ProfileCount,1)</visible>
						<visible>System.Loggedon</visible>
					</control>
					
					<include content="DialogRowButton">
						<param name="id">606</param>
						<param name="coords">DialogButtonMenu_coords3</param>
						<param name="label">20046</param>
						<param name="onclick">Mastermode</param>
						<param name="visible">System.HasLocks + System.IsMaster</param>
					</include>
					
					<control type="button" id="607">
						<include>DialogButtonMenu_coords3</include>
						<altlabel>20045</altlabel>
						<texturefocus colordiffuse="$VAR[buttonfocus]">common/focus52c.png</texturefocus>
						<onclick>Mastermode</onclick>
						<align>center</align>
						<visible>System.HasLocks + !System.IsMaster</visible>
					</control>
					
					<include content="DialogRowButton">
						<param name="id">608</param>
						<param name="coords">DialogButtonMenu_coords3</param>
						<param name="label">13017</param>
						<param name="onclick">InhibitIdleShutdown(true)</param>
						<param name="visible">System.HasShutdown +!System.IsInhibit</param>
					</include>
					
					<include content="DialogRowButton">
						<param name="id">609</param>
						<param name="coords">DialogButtonMenu_coords3</param>
						<param name="label">13018</param>
						<param name="onclick">InhibitIdleShutdown(false)</param>
						<param name="visible">System.HasShutdown + System.IsInhibit</param>
					</include>
					
					<control type="button" id="610">
						<include>DialogButtonMenu_coords3</include>
						<label>20150</label>
						<texturefocus colordiffuse="$VAR[buttonfocus]">common/focus52c.png</texturefocus>
						<onclick>AlarmClock(shutdowntimer,Shutdown)</onclick>
						<align>center</align>
						<visible>!System.HasAlarm(shutdowntimer)</visible>
						<visible>System.CanPowerDown | System.CanSuspend | System.CanHibernate</visible>
					</control>
					
					<include content="DialogRowButton">
						<param name="id">611</param>
						<param name="coords">DialogButtonMenu_coords3</param>
						<param name="label">20151 $INFO[System.Alarmpos,T-]</param>
						<param name="onclick">CancelAlarm(shutdowntimer)</param>
						<param name="visible">System.HasAlarm(shutdowntimer)</param>
					</include>
					
					<control type="button" id="612">
						<include>DialogButtonMenu_coords3</include>
						<label>5</label>
						<texturefocus colordiffuse="$VAR[buttonfocus]">common/focus52c.png</texturefocus>
						<onclick>Close</onclick>
						<align>center</align>
						<onclick>ActivateWindow(Settings)</onclick>
					</control>
					
				</control>
			</control>
		</control>

		<include>MaskingBars</include>

	</controls>

</window>