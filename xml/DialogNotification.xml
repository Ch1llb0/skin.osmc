<?xml version="1.0" encoding="UTF-8"?>
<window>
	<!-- infodialog -->
	<include>CornerWindowAnimation</include>
	<zorder>100</zorder>
	
	<controls>
	
		<control type="group">
			<include>NotificationDepth</include>
			<include>CornerWindowLiftAboveVolumeBar</include>
		
			<!-- Background -->
			<control type="image">
				<include>DialogNotification_coords1</include>
				<texture colordiffuse="$VAR[MenuOSDColor]">$VAR[MenuOSDBackground]</texture>
			</control>
			
			<!-- Default icon -->
			<control type="image" id="400">
				<include>DialogNotification_coords2</include>
			</control>

			<!-- Heading -->
			<control type="label" id="401">
				<include>DialogNotification_coords3</include>
				<align>left</align>
				<scroll>True</scroll>
				<scrollspeed>44</scrollspeed>
				<font>Font27</font>
			</control>

			<!-- Details -->
			<control type="fadelabel" id="402">
				<include>DialogNotification_coords4</include>
				<align>left</align>
				<aligny>top</aligny>
				<font>Font27-light</font>
				<scrollspeed>44</scrollspeed>
			</control>

		</control>

	</controls>

</window>