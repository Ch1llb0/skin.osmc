<?xml version="1.0" encoding="UTF-8"?>
<window>
	<!-- volumebar -->
	<include>CornerWindowAnimation</include>
	<zorder>100</zorder>
	
	<!-- Scroll reset -->
	<include>ResetScroll</include>
	
	<controls>
	
		<control type="group">
			<include>DialogDepth</include>
			<include>CornerWindowLift</include>
			
			<!-- Background -->
			<control type="image">
				<include>DialogVolumeBar_coords1</include>
				<texture colordiffuse="$VAR[MenuOSDColor]">$VAR[MenuOSDBackground]</texture>
			</control>

			<!-- Heading -->
			<control type="label">
				<include>DialogVolumeBar_coords2</include>
				<align>left</align>
				<scroll>True</scroll>
				<scrollspeed>44</scrollspeed>
				<font>Font27</font>
				<label>[LIGHT]$LOCALIZE[13376][/LIGHT] $INFO[Control.GetLabel(404),,%]</label>
				<visible>!Player.Muted</visible>
			</control>

			<!-- Muted -->
			<control type="label">
				<include>DialogVolumeBar_coords2</include>
				<align>left</align>
				<scroll>True</scroll>
				<scrollspeed>44</scrollspeed>
				<font>Font27</font>
				<label>[LIGHT]$LOCALIZE[13376][/LIGHT] $LOCALIZE[31013]</label>
				<visible>Player.Muted</visible>
			</control>

			<!-- Progress -->
			<control type="progress" id="404">
				<visible>false</visible>
				<info>player.volume</info>
			</control>

		</control>

	</controls>

</window>