<?xml version="1.0" encoding="UTF-8"?>
<includes>
	<!-- The select dialog, and the game OSD dialogs that load it -->
	<include name="DialogSelectLayout">
		<!-- Select dialog -->
		<control type="group">
			<visible>![Window.IsVisible(gamevideofilter) | Window.IsVisible(gamestretchmode) | Window.IsVisible(gamevideorotation) | Window.IsVisible(ingamesaves)]</visible>

			<!-- Dialog fanart -->
			<include>DialogBackgroundImage</include>

			<control type="group">
				<include>DialogFrame</include>

				<control type="label" id="1">
					<font></font>
				</control>

				<control type="label" id="10823">
					<font></font>
				</control>

				<!-- Image -->
				<control type="image">
					<include>DialogSelect_coords1</include>
					<texture diffuse="common/masks/art-405x600.png">$VAR[SelectImage]</texture>
					<aspectratio aligny="center">keep</aspectratio>
					<visible>Control.IsVisible(6)</visible>
				</control>

				<!-- Image -->
				<control type="image">
					<include>DialogSelect_coords1</include>
					<texture diffuse="common/masks/art-405x600.png">$INFO[Container(3).ListItem.Art(screenshot)]</texture>
					<aspectratio aligny="center">keep</aspectratio>
					<visible>Window.IsActive(gamesaves)</visible>
				</control>

				<!-- Savegame info -->
				<control type="fadelabel">
					<include>DialogVideoInfo_coords2</include>
					<font>Font27</font>
					<scrollspeed>44</scrollspeed>
					<align>center</align>
					<label>$LOCALIZE[35255] $INFO[Control.GetLabel(10823)]</label>
					<textcolor>$VAR[TextColorNF]</textcolor>
					<visible>Window.IsActive(gamesaves) + Control.HasFocus(3)</visible>
					<include>VisibleFadeAnimation</include>
				</control>

				<!-- List -->
				<control type="list" id="3">
					<include>DialogSelect_coords2</include>
					<onup>3</onup>
					<ondown>3</ondown>
					<onleft>60</onleft>
					<onright>9001</onright>
					<orientation>vertical</orientation>
					<pagecontrol>60</pagecontrol>
					<viewtype label="$LOCALIZE[535]">list</viewtype>
					<scrolltime tween="sine" easing="out">240</scrolltime>

					<include>DialogSelect_coords3</include>

					<include>DialogSelect_coords4</include>
				</control>

				<!-- List -->
				<control type="list" id="6">
					<include>DialogSelect_coords5</include>
					<onup>6</onup>
					<ondown>6</ondown>
					<onleft>60</onleft>
					<onright>9001</onright>
					<orientation>vertical</orientation>
					<pagecontrol>60</pagecontrol>
					<viewtype label="$LOCALIZE[535]">list</viewtype>
					<scrolltime tween="sine" easing="out">240</scrolltime>

					<include>DialogSelect_coords6</include>

					<include>DialogSelect_coords7</include>
				</control>

				<!-- Scrollbar -->
				<control type="scrollbar" id="60">
					<include>DialogSelect_coords8</include>
					<onleft>5</onleft>
					<onright condition="Control.IsVisible(3)">3</onright>
					<onright condition="Control.IsVisible(6)">6</onright>
					<orientation>vertical</orientation>
					<texturesliderbackground border="0,5,0,5">common/ScrollBackground.png</texturesliderbackground>
					<texturesliderbar border="0,5,0,5" colordiffuse="$VAR[OverlayColorNF]">common/ScrollbarGripNF.png</texturesliderbar>
					<texturesliderbarfocus border="0,5,0,5" colordiffuse="$VAR[OverlayColorFO]">common/ScrollbarGripFO.png</texturesliderbarfocus>
					<visible>!Skin.HasSetting(Scrollbars)</visible>
				</control>

				<!-- Buttons -->
				<control type="grouplist" id="9001">
					<include>DialogButtons</include>
					<itemgap>30</itemgap>
					<onup condition="Control.IsVisible(3)">3</onup>
					<onup condition="Control.IsVisible(6)">6</onup>
					<orientation>horizontal</orientation>
					<align>center</align>
					<defaultcontrol always="true">0</defaultcontrol>

					<!-- OK / Get more Button -->
					<control type="button" id="5">
						<width>Auto</width>
						<visible>!Window.IsActive(gamesaves)</visible>
					</control>

					<!-- Cancel Button -->
					<control type="button" id="7">
						<width>Auto</width>
						<visible>!Window.IsActive(gamesaves)</visible>
					</control>

					<!-- Get more Button -->
					<control type="button" id="8">
						<width>Auto</width>
						<visible>!Window.IsActive(gamesaves)</visible>
					</control>

					<!-- New savegame Button -->
					<control type="button" id="10825">
						<label>$LOCALIZE[35261]</label>
						<width>Auto</width>
						<visible>Window.IsActive(gamesaves)</visible>
					</control>

					<!-- Cancel Button -->
					<control type="button" id="10826">
						<label>$LOCALIZE[222]</label>
						<width>Auto</width>
						<visible>Window.IsActive(gamesaves)</visible>
					</control>
				</control>

				<!-- Button indicator -->
				<include content="dialogButtonIndicator">
					<param name="visibility">!ControlGroup(9001).HasFocus + !Window.IsVisible(shutdownmenu)</param>
				</include>
			</control>

			<include>MaskingBars</include>
		</control>

		<!-- Game OSD dialog -->
		<control type="group">
			<include>DialogDepth</include>
			<visible>[Window.IsVisible(gamevideofilter) | Window.IsVisible(gamestretchmode) | Window.IsVisible(gamevideorotation) | Window.IsVisible(ingamesaves)] + !Window.IsVisible(shutdownmenu)</visible>

			<!-- Animation -->
			<animation effect="slide" start="0,500" time="200">WindowOpen</animation>
			<animation effect="slide" end="0,500" time="200">WindowClose</animation>
			<animation effect="slide" start="0,500" time="200">Visible</animation>
			<animation effect="slide" end="0,500" time="200">Hidden</animation>

			<!-- Window Background -->
			<control type="image">
				<include>DialogSelect_coords9</include>
				<texture border="8" colordiffuse="$VAR[MenuOSDColor]">$VAR[MenuOSDPanel]</texture>
			</control>

			<!-- Heading -->
			<control type="label" id="1">
				<include>DialogSelect_coords10</include>
				<align>center</align>
				<aligny>top</aligny>
				<font>Font33</font>
				<label>$INFO[Control.GetLabel(1)]</label>
			</control>

			<!-- Panel -->
			<control type="panel" id="10811">
				<include>DialogSelect_coords11</include>
				<onup>Close</onup>
				<ondown>Close</ondown>
				<orientation>horizontal</orientation>
				<scrolltime tween="sine" easing="out">240</scrolltime>

				<include>DialogSelect_coords12</include>

				<include>DialogSelect_coords13</include>
			</control>

			<control type="textbox" id="12">
				<include>DialogSelect_coords14</include>
				<font>Font30</font>
				<align>center</align>
				<autoscroll delay="10000" time="2000" repeat="12000">True</autoscroll>
				<visible>Window.IsActive(gamevideofilter)</visible>
				<textcolor>$VAR[TextColorFO]</textcolor>
			</control>
		</control>
	</include>

	<!-- Kodi's stream lists, laid out as the bookmarks: the OSD rows give way, the progress bar stays,
	     the streams sit in a panel above it and a button row takes the OSD bar's place. Picking a
	     stream switches to it and closes the panel, as back does. -->
	<include name="DialogSelectStreamLayout">
		<control type="group">
			<include>DialogDepth</include>
			<visible>$EXP[StreamSelectTopmost] + !Window.IsVisible(playerprocessinfo) + String.IsEmpty(Window(home).Property(service.upnext.dialog))</visible>
			<include>OSDVisibleHiddenAnimation</include>

			<!-- Panel: five streams at most, shorter with fewer, its foot 18 px above the progress bar; heading and
			     rows as in the OSD settings dialogs -->
			<control type="group">
				<include>DialogSelect_coords15</include>
				<include>StreamSelectOpenCloseAnimation</include>
				<animation effect="slide" end="0,200" time="0" condition="Integer.IsEqual(Container(3).NumItems,1)">Conditional</animation>
				<animation effect="slide" end="0,150" time="0" condition="Integer.IsEqual(Container(3).NumItems,2)">Conditional</animation>
				<animation effect="slide" end="0,100" time="0" condition="Integer.IsEqual(Container(3).NumItems,3)">Conditional</animation>
				<animation effect="slide" end="0,50" time="0" condition="Integer.IsEqual(Container(3).NumItems,4)">Conditional</animation>

				<!-- Heading -->
				<control type="label" id="1">
					<include>DialogSelect_coords16</include>
					<font>Font33</font>
					<align>center</align>
					<aligny>top</aligny>
				</control>

				<!-- List -->
				<control type="list" id="3">
					<include>DialogSelect_coords17</include>
					<onup>3</onup>
					<ondown>9001</ondown>
					<onleft>60</onleft>
					<onright>noop</onright>
					<orientation>vertical</orientation>
					<pagecontrol>60</pagecontrol>
					<scrolltime tween="sine" easing="out">240</scrolltime>

					<include>DialogSelect_coords18</include>

					<include>DialogSelect_coords19</include>
				</control>

				<!-- Scrollbar -->
				<control type="scrollbar" id="60">
					<include>DialogSelect_coords20</include>
					<onright>3</onright>
					<ondown>9001</ondown>
					<orientation>vertical</orientation>
					<texturesliderbackground border="0,5,0,5">common/ScrollBackground.png</texturesliderbackground>
					<texturesliderbar border="0,5,0,5" colordiffuse="$VAR[OverlayColorNF]">common/ScrollbarGripNF.png</texturesliderbar>
					<texturesliderbarfocus border="0,5,0,5" colordiffuse="$VAR[OverlayColorFO]">common/ScrollbarGripFO.png</texturesliderbarfocus>
					<visible>$EXP[StreamSelectScrollbar]</visible>
				</control>
			</control>

			<!-- Buttons, where the OSD bar was -->
			<control type="group">
				<include>DialogSelect_coords21</include>
				<include>StreamSelectOpenCloseAnimation</include>

				<!-- Background -->
				<control type="image">
					<include>DialogSelect_coords22</include>
					<texture border="8" colordiffuse="$VAR[MenuOSDColor]">$VAR[MenuOSDPanel]</texture>
				</control>

				<!-- Button grouplist. 20 on, as Kodi writes its own labels into 10 to 12. A settings dialog opens over
				     the panel, so closing it comes back to the button. -->
				<control type="grouplist" id="9001">
					<include>DialogSelect_coords23</include>
					<itemgap>20</itemgap>
					<align>center</align>
					<onleft>9001</onleft>
					<onright>9001</onright>
					<onup>3</onup>
					<ondown>noop</ondown>
					<orientation>horizontal</orientation>

					<!-- Close -->
					<control type="button" id="20">
						<include>DialogSelect_coords24</include>
						<align>center</align>
						<texturefocus colordiffuse="$VAR[buttonfocus]">common/focus52c.png</texturefocus>
						<label>15067</label>
						<onclick>Action(Back)</onclick>
					</control>

					<!-- Video settings -->
					<control type="button" id="21">
						<include>DialogSelect_coords24</include>
						<align>center</align>
						<texturefocus colordiffuse="$VAR[buttonfocus]">common/focus52c.png</texturefocus>
						<label>13395</label>
						<onclick>ActivateWindow(osdvideosettings)</onclick>
						<visible>Window.IsActive(dialogselectvideo)</visible>
					</control>

					<!-- Audio settings -->
					<control type="button" id="22">
						<include>DialogSelect_coords24</include>
						<align>center</align>
						<texturefocus colordiffuse="$VAR[buttonfocus]">common/focus52c.png</texturefocus>
						<label>13396</label>
						<onclick>ActivateWindow(osdaudiosettings)</onclick>
						<visible>Window.IsActive(dialogselectaudio)</visible>
					</control>

					<!-- Subtitle settings -->
					<control type="button" id="23">
						<include>DialogSelect_coords24</include>
						<align>center</align>
						<texturefocus colordiffuse="$VAR[buttonfocus]">common/focus52c.png</texturefocus>
						<label>24133</label>
						<onclick>ActivateWindow(osdsubtitlesettings)</onclick>
						<visible>Window.IsActive(dialogselectsubtitle)</visible>
					</control>

					<!-- Subtitle download -->
					<control type="button" id="24">
						<include>DialogSelect_coords24</include>
						<align>center</align>
						<texturefocus colordiffuse="$VAR[buttonfocus]">common/focus52c.png</texturefocus>
						<label>33003</label>
						<onclick>ActivateWindow(subtitlesearch)</onclick>
						<visible>Window.IsActive(dialogselectsubtitle)</visible>
					</control>
				</control>
			</control>
		</control>
	</include>

	<!-- As the bookmarks: opened from the OSD, the panel waits for the OSD to fade first -->
	<include name="StreamSelectOpenCloseAnimation">
		<animation type="WindowOpen" condition="Window.IsVisible(VideoOSD)">
			<effect type="zoom" start="90" end="100" center="auto" tween="back" easing="out" time="200" delay="200" />
			<effect type="fade" start="0" end="100" time="200" delay="200" />
		</animation>
		<animation type="WindowOpen" condition="!Window.IsVisible(VideoOSD)">
			<effect type="zoom" start="90" end="100" center="auto" tween="back" easing="out" time="200" />
			<effect type="fade" start="0" end="100" time="200" />
		</animation>
		<animation type="WindowClose">
			<effect type="zoom" start="100" end="90" center="auto" easing="in" time="200"/>
			<effect type="fade" start="100" end="0" time="200"/>
		</animation>
	</include>
</includes>
