<?xml version="1.0" encoding="UTF-8"?>
<includes>
	<include name="Viewtype526">
		<!-- Wide low info -->
		<control type="group">
			<visible>Control.IsVisible(526)</visible>

			<!-- List -->
			<control type="fixedlist" id="526">
				<include>Viewtype526_coords1</include>
				<ondown>61</ondown>
				<onleft>526</onleft>
				<onright>526</onright>
				<pagecontrol>61</pagecontrol>
				<orientation>horizontal</orientation>
				<viewtype label="$LOCALIZE[31457]">wide</viewtype>
				<scrolltime tween="sine" easing="out">240</scrolltime>
				<visible>Container.Content(movies) | Container.Content(sets) | Container.Content(tvshows) | Container.Content(seasons)</visible>

				<include>Viewtype526_coords2</include>

				<include>Viewtype526_coords3</include>
			</control>

			<control type="group">
				<include>Viewtype526_coords4</include>

				<!-- Title -->
				<control type="fadelabel">
					<include>Viewtype526_coords5</include>
					<font>Font72</font>
					<align>center</align>
					<textcolor>$VAR[TextColorFO]</textcolor>
					<label>$VAR[Label1]</label>
					<scrollspeed>120</scrollspeed>
				</control>

				<!-- Details -->
				<control type="fadelabel">
					<include>Viewtype526_coords6</include>
					<font>Font27</font>
					<scrollspeed>44</scrollspeed>
					<align>center</align>
					<aligny>top</aligny>
					<label>$VAR[Label2]</label>
					<textcolor>$VAR[TextColorFO]</textcolor>
				</control>
			</control>

			<!-- Plot -->
			<control type="group">
				<include>Viewtype526_coords7</include>
				<visible>Container.Content(movies) | Container.Content(sets) | Container.Content(tvshows) | Container.Content(seasons)</visible>
				<visible>!String.IsEmpty(ListItem.Plot) | !String.IsEmpty(ListItem.PlotOutline)</visible>
				<control type="textbox">
					<include>Viewtype526_coords8</include>
					<align>left</align>
					<font>Font27</font>
					<label>$INFO[ListItem.Plot]$VAR[ResetScroll]</label>
					<textcolor>$VAR[TextColorFO]</textcolor>
					<autoscroll delay="5000" time="1400" repeat="10000">true</autoscroll>
					<visible>Skin.String(PlotFont,S)</visible>
				</control>
				<control type="textbox">
					<include>Viewtype526_coords9</include>
					<align>left</align>
					<font>Font30</font>
					<label>$INFO[ListItem.Plot]$VAR[ResetScroll]</label>
					<textcolor>$VAR[TextColorFO]</textcolor>
					<autoscroll delay="5000" time="1300" repeat="10000">true</autoscroll>
					<visible>Skin.String(PlotFont,M)</visible>
				</control>
				<control type="textbox">
					<include>Viewtype526_coords10</include>
					<align>left</align>
					<font>Font33</font>
					<label>$INFO[ListItem.Plot]$VAR[ResetScroll]</label>
					<textcolor>$VAR[TextColorFO]</textcolor>
					<autoscroll delay="5000" time="1200" repeat="10000">true</autoscroll>
					<visible>Skin.String(PlotFont,L)</visible>
				</control>
				<control type="textbox">
					<include>Viewtype526_coords11</include>
					<align>left</align>
					<font>Font36</font>
					<label>$INFO[ListItem.Plot]$VAR[ResetScroll]</label>
					<textcolor>$VAR[TextColorFO]</textcolor>
					<autoscroll delay="5000" time="1100" repeat="10000">true</autoscroll>
					<visible>Skin.String(PlotFont,XL)</visible>
				</control>
			</control>
		</control>
	</include>
</includes>
