	<!-- Disc manager: drawn as the game OSD panel it opens from. Kodi drives five buttons when the dialog has
	     no menu list (id 3), and they read as the OSD's own rows; the disc list takes their place. Changing
	     discs needs the tray open, so Disc selection, Add and Delete are disabled while it is closed -->
	<include name="DialogGameControllers_DiscManager">
		<controls>
			<control type="group">
				<include>DialogDepth</include>
				<include>DialogGameControllers_coords17</include>
				<visible>Window.IsVisible(gamediscmanager) + !Window.IsVisible(shutdownmenu)</visible>
				<include content="OSDReplaceOpenCloseAnimation">
					<param name="osd" value="Window.IsVisible(gameosd)" />
				</include>
				<include>OSDVisibleHiddenAnimation</include>

				<control type="group">
					<!-- Five rows at most, the panel kept centred: 25 px lower for each row a shorter disc list lacks -->
					<animation effect="slide" end="0,25" time="0" condition="$EXP[DiscManagerList] + Integer.IsEqual(Container(108321).NumItems,4)">Conditional</animation>
					<animation effect="slide" end="0,50" time="0" condition="$EXP[DiscManagerList] + Integer.IsEqual(Container(108321).NumItems,3)">Conditional</animation>
					<animation effect="slide" end="0,75" time="0" condition="$EXP[DiscManagerList] + Integer.IsEqual(Container(108321).NumItems,2)">Conditional</animation>
					<animation effect="slide" end="0,100" time="0" condition="$EXP[DiscManagerList] + Integer.IsEqual(Container(108321).NumItems,1)">Conditional</animation>

					<!-- Background, one per row count -->
					<control type="image">
						<include>DialogGameControllers_coords18</include>
						<texture border="8" colordiffuse="$VAR[MenuOSDColor]">$VAR[MenuOSDPanel]</texture>
						<visible>!$EXP[DiscManagerList] | Integer.IsGreaterOrEqual(Container(108321).NumItems,5)</visible>
					</control>
					<control type="image">
						<include>DialogGameControllers_coords19</include>
						<texture border="8" colordiffuse="$VAR[MenuOSDColor]">$VAR[MenuOSDPanel]</texture>
						<visible>$EXP[DiscManagerList] + Integer.IsEqual(Container(108321).NumItems,4)</visible>
					</control>
					<control type="image">
						<include>DialogGameControllers_coords20</include>
						<texture border="8" colordiffuse="$VAR[MenuOSDColor]">$VAR[MenuOSDPanel]</texture>
						<visible>$EXP[DiscManagerList] + Integer.IsEqual(Container(108321).NumItems,3)</visible>
					</control>
					<control type="image">
						<include>DialogGameControllers_coords21</include>
						<texture border="8" colordiffuse="$VAR[MenuOSDColor]">$VAR[MenuOSDPanel]</texture>
						<visible>$EXP[DiscManagerList] + Integer.IsEqual(Container(108321).NumItems,2)</visible>
					</control>
					<control type="image">
						<include>DialogGameControllers_coords22</include>
						<texture border="8" colordiffuse="$VAR[MenuOSDColor]">$VAR[MenuOSDPanel]</texture>
						<visible>$EXP[DiscManagerList] + Integer.IsEqual(Container(108321).NumItems,1)</visible>
					</control>

					<!-- Heading, and the game under it -->
					<control type="label">
						<include>DialogGameControllers_coords23</include>
						<align>center</align>
						<aligny>top</aligny>
						<font>Font33</font>
						<label>$LOCALIZE[35272]</label>
					</control>
					<control type="label">
						<include>DialogGameControllers_coords24</include>
						<align>center</align>
						<aligny>top</aligny>
						<font>Font27</font>
						<textcolor>$VAR[TextColorNF]</textcolor>
						<label>$INFO[RetroPlayer.Title]</label>
					</control>

					<!-- Menu: id 3 for the window's default focus, which lands on its first enabled button; Kodi only
					     takes a container with that id as its menu, so the buttons stay its menu -->
					<control type="grouplist" id="3">
						<include>DialogGameControllers_coords25</include>
						<itemgap>0</itemgap>
						<orientation>vertical</orientation>
						<visible>!$EXP[DiscManagerList]</visible>

						<!-- Disc selection: Kodi writes the disc in the tray as label2 -->
						<control type="button" id="108323">
							<include>DialogGameControllers_coords26</include>
							<aligny>top</aligny>
							<textoffsety>2</textoffsety>
							<texturefocus border="2,0,0,0" colordiffuse="$VAR[buttonfocus]">common/focus50.png</texturefocus>
							<label>$LOCALIZE[35273]</label>
							<enable>RetroPlayer.DiscEjected</enable>
						</control>

						<!-- Eject, or Insert with label2 Tray open: Kodi writes both -->
						<control type="button" id="108324">
							<include>DialogGameControllers_coords26</include>
							<aligny>top</aligny>
							<textoffsety>2</textoffsety>
							<texturefocus border="2,0,0,0" colordiffuse="$VAR[buttonfocus]">common/focus50.png</texturefocus>
							<label>$LOCALIZE[35275]</label>
						</control>

						<!-- Add -->
						<control type="button" id="108325">
							<include>DialogGameControllers_coords26</include>
							<aligny>top</aligny>
							<textoffsety>2</textoffsety>
							<texturefocus border="2,0,0,0" colordiffuse="$VAR[buttonfocus]">common/focus50.png</texturefocus>
							<label>$LOCALIZE[15019]</label>
							<enable>RetroPlayer.DiscEjected</enable>
						</control>

						<!-- Delete -->
						<control type="button" id="108326">
							<include>DialogGameControllers_coords26</include>
							<aligny>top</aligny>
							<textoffsety>2</textoffsety>
							<texturefocus border="2,0,0,0" colordiffuse="$VAR[buttonfocus]">common/focus50.png</texturefocus>
							<label>$LOCALIZE[117]</label>
							<enable>RetroPlayer.DiscEjected</enable>
						</control>

						<!-- Resume game -->
						<control type="button" id="108327">
							<include>DialogGameControllers_coords26</include>
							<aligny>top</aligny>
							<textoffsety>2</textoffsety>
							<texturefocus border="2,0,0,0" colordiffuse="$VAR[buttonfocus]">common/focus50.png</texturefocus>
							<label>$LOCALIZE[35277]</label>
						</control>
					</control>

					<!-- Discs: the one in the tray in the selected colour, as the stream lists mark theirs -->
					<!-- The list shows on its group, not itself: Kodi focuses it in the same step that shows it, and a
					     control hidden by its own condition cannot take focus until the next frame -->
					<control type="group">
						<visible>$EXP[DiscManagerList]</visible>
						<control type="list" id="108321">
							<include>DialogGameControllers_coords27</include>
							<onup>108321</onup>
							<ondown>108321</ondown>
							<onleft>108322</onleft>
							<orientation>vertical</orientation>
							<pagecontrol>108322</pagecontrol>
							<scrolltime tween="sine" easing="out">240</scrolltime>

							<include>DialogGameControllers_coords28</include>

							<include>DialogGameControllers_coords29</include>
						</control>
					</control>

					<!-- Scrollbar -->
					<control type="scrollbar" id="108322">
						<include>DialogGameControllers_coords30</include>
						<onright>108321</onright>
						<orientation>vertical</orientation>
						<texturesliderbackground border="0,5,0,5">common/ScrollBackground.png</texturesliderbackground>
						<texturesliderbar border="0,5,0,5" colordiffuse="$VAR[OverlayColorNF]">common/ScrollbarGripNF.png</texturesliderbar>
						<texturesliderbarfocus border="0,5,0,5" colordiffuse="$VAR[OverlayColorFO]">common/ScrollbarGripFO.png</texturesliderbarfocus>
						<visible>$EXP[DiscManagerList] + $EXP[DiscManagerScrollbar]</visible>
					</control>
				</control>
			</control>
		</controls>
	</include>

	<!-- Achievements: the select dialog's 96 px list, the game and its progress in the image slot over the
	     three switches Kodi reads (it sets none of them, so each shows its setting), a switch's help on the
	     line above the buttons. Signed out, or opened from settings with no game, it shows the sign-up code -->
	<include name="DialogGameControllers_Achievements">
		<onload condition="!$EXP[GameAchievementsSignedIn]">SetFocus(9001)</onload>
		<controls>
			<control type="group">
				<include>DialogDepth</include>
				<visible>Window.IsVisible(gameachievements)</visible>

				<!-- Dialog fanart -->
				<include>DialogBackgroundImage</include>

				<control type="group">
					<include content="DialogFrame">
						<param name="heading">$LOCALIZE[35287]</param>
					</include>

					<control type="group">
						<visible>$EXP[GameAchievementsSignedIn]</visible>

						<!-- Game and progress -->
						<control type="label">
							<include>DialogGameControllers_coords31</include>
							<font>Font36</font>
							<label>$INFO[Window.Property(Achievements.GameTitle)]</label>
						</control>
						<control type="label">
							<include>DialogGameControllers_coords32</include>
							<font>Font27</font>
							<textcolor>$VAR[TextColorNF]</textcolor>
							<label>$INFO[RetroPlayer.AchievementsProgress]$INFO[Window.Property(Achievements.Progress), &#8226; ,]</label>
						</control>

						<!-- Switches: Kodi hides hardcore mode until the emulator is approved for it -->
						<control type="grouplist" id="108334">
							<include>DialogGameControllers_coords33</include>
							<itemgap>0</itemgap>
							<orientation>vertical</orientation>
							<onright>3</onright>
							<ondown>9001</ondown>

							<control type="radiobutton" id="108340">
								<include>DialogGameControllers_coords34</include>
								<label>$LOCALIZE[35700]</label>
								<selected>System.GetBool(gamesachievements.hardcore)</selected>
							</control>
							<control type="radiobutton" id="108331">
								<include>DialogGameControllers_coords34</include>
								<label>$LOCALIZE[35303]</label>
								<selected>System.GetBool(gamesachievements.encore)</selected>
							</control>
							<control type="radiobutton" id="108332">
								<include>DialogGameControllers_coords34</include>
								<label>$LOCALIZE[35364]</label>
								<selected>System.GetBool(gamesachievements.challengeindicator)</selected>
							</control>
						</control>

						<!-- Achievements, earned first -->
						<control type="list" id="3">
							<include>DialogGameControllers_coords35</include>
							<onup>3</onup>
							<ondown>3</ondown>
							<onleft condition="!Skin.HasSetting(Scrollbars)">60</onleft>
							<onleft condition="Skin.HasSetting(Scrollbars)">108334</onleft>
							<onright>9001</onright>
							<orientation>vertical</orientation>
							<pagecontrol>60</pagecontrol>
							<scrolltime tween="sine" easing="out">240</scrolltime>

							<include>DialogGameControllers_coords36</include>

							<include>DialogGameControllers_coords37</include>
						</control>

						<!-- Scrollbar -->
						<control type="scrollbar" id="60">
							<include>DialogGameControllers_coords38</include>
							<onleft>108334</onleft>
							<onright>3</onright>
							<orientation>vertical</orientation>
							<texturesliderbackground border="0,5,0,5">common/ScrollBackground.png</texturesliderbackground>
							<texturesliderbar border="0,5,0,5" colordiffuse="$VAR[OverlayColorNF]">common/ScrollbarGripNF.png</texturesliderbar>
							<texturesliderbarfocus border="0,5,0,5" colordiffuse="$VAR[OverlayColorFO]">common/ScrollbarGripFO.png</texturesliderbarfocus>
							<visible>!Skin.HasSetting(Scrollbars)</visible>
						</control>

						<!-- Help for the focused switch -->
						<control type="fadelabel">
							<include>DialogVideoInfo_coords2</include>
							<font>Font27</font>
							<scrollspeed>44</scrollspeed>
							<align>center</align>
							<label>$VAR[GameAchievementsHelp]</label>
							<textcolor>$VAR[TextColorNF]</textcolor>
							<include>VisibleFadeAnimation</include>
						</control>
					</control>

					<!-- Signed out: the code to scan for an account -->
					<control type="group">
						<visible>!$EXP[GameAchievementsSignedIn]</visible>
