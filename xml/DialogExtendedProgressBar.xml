<?xml version="1.0" encoding="UTF-8"?>
<window>
	<!-- extendedprogressdialog -->
	<include>CornerWindowAnimation</include>
	<zorder>100</zorder>
	
	<controls>
	
		<control type="group">
			<include>NotificationDepth</include>
			<include>CornerWindowLiftAboveNotification</include>
			
			<!-- Background -->
			<control type="image">
				<include>DialogExtendedProgressBar_coords1</include>
				<texture colordiffuse="$VAR[MenuOSDColor]">$VAR[MenuOSDBackground]</texture>
			</control>
			
			<!-- Busy spinner -->
			<control type="image">
				<include>DialogExtendedProgressBar_coords2</include>
				<texture colordiffuse="$VAR[OverlayColorFO]">$VAR[BusySpinnerSmall]</texture>
			</control>

			<!-- Heading -->
			<control type="label" id="30">
				<include>DialogExtendedProgressBar_coords3</include>
				<align>left</align>
				<scroll>True</scroll>
				<scrollspeed>44</scrollspeed>
				<font>Font27</font>
			</control>

			<!-- Details -->
			<control type="fadelabel" id="31">
				<include>DialogExtendedProgressBar_coords4</include>
				<align>left</align>
				<aligny>top</aligny>
				<font>Font27-light</font>
				<scrollspeed>44</scrollspeed>
			</control>

			<!-- Progress -->
			<control type="progress" id="32">
				<include>DialogExtendedProgressBar_coords5</include>
				<midtexture colordiffuse="$VAR[OverlayColorFO]">common/white.png</midtexture>
			</control>
		</control>

	</controls>

</window>