<?xml version="1.0" encoding="UTF-8"?>
<window>
	<!-- extendedprogressdialog -->
	<include>CornerWindowAnimation</include>
	<zorder>100</zorder>
	
	<controls>
	
		<control type="group">
			<include>NotificationDepth</include>
			<include>CornerWindowLiftAboveNotification</include>
			
			<!-- Background -->
			<control type="image">
				<include>DialogExtendedProgressBar_coords1</include>
				<texture border="8" colordiffuse="$VAR[MenuOSDColor]">$VAR[MenuOSDPanel]</texture>
			</control>
			
			<!-- Busy spinner -->
			<control type="image">
				<include>DialogExtendedProgressBar_coords2</include>
				<texture colordiffuse="$VAR[OverlayColorFO]">$VAR[BusySpinnerMedium]</texture>
			</control>

			<!-- Heading -->
			<control type="label" id="30">
				<include>DialogExtendedProgressBar_coords3</include>
				<align>left</align>
				<scroll>True</scroll>
				<scrollspeed>44</scrollspeed>
				<font>Font27</font>
			</control>

			<!-- Details -->
			<control type="fadelabel" id="31">
				<include>DialogExtendedProgressBar_coords4</include>
				<align>left</align>
				<aligny>top</aligny>
				<font>Font27-light</font>
				<scrollspeed>44</scrollspeed>
			</control>

			<!-- Progress -->
			<control type="progress" id="32">
				<include>DialogExtendedProgressBar_coords5</include>
				<texturebg border="6,0,6,0" colordiffuse="$VAR[OverlayColorFO]">common/PanelProgressBack.png</texturebg>
				<midtexture border="6,0,0,0" colordiffuse="$VAR[OverlayColorFO]">common/PanelProgressBar.png</midtexture>
			</control>
		</control>

	</controls>

</window>