<?xml version="1.0" encoding="UTF-8"?>
<window>
	<!-- GameOSD -->
	<defaultcontrol always="true">5</defaultcontrol>

	<!-- Scroll reset -->
	<include>ResetScroll</include>

	<controls>
		<!-- Player status -->
		<control type="group">
			<include>DialogDepth</include>
			<include>GameOSD_coords1</include>
			<visible>Player.Forwarding | Player.Rewinding | Player.IsTempo | Player.Paused</visible>
			<visible>![Window.IsVisible(gamevideofilter) | Window.IsVisible(gamestretchmode) | Window.IsVisible(gamevideorotation) | Window.IsVisible(ingamesaves) | Window.IsVisible(gamevolume) | Window.IsVisible(gamecontrollers) | Window.IsVisible(gameadvancedsettings) | Window.IsVisible(GamePorts) | Window.IsVisible(gamediscmanager) | Window.IsVisible(gameachievements) | Window.IsVisible(gameleaderboards) | Window.IsVisible(gameleaderboardentries) | Window.IsVisible(gamecheats) | Window.IsVisible(shutdownmenu)]</visible>
			<include>OSDVisibleHiddenAnimation</include>
			<include>OSDOpenCloseAnimation</include>

			<!-- Background -->
			<control type="image" id="1">
				<include>GameOSD_coords2</include>
				<texture border="8" colordiffuse="$VAR[MenuOSDColor]">$VAR[MenuOSDPanel]</texture>
			</control>

			<!-- Pause -->
			<control type="image" id="1">
			<include>GameOSD_coords3</include>
				<texture colordiffuse="$VAR[OverlayColorFO]">osd/OSDPause.png</texture>
				<visible>player.paused</visible>
			</control>
		</control>

		<control type="group">
			<include>DialogDepth</include>
			<include>GameOSD_coords4</include>
			<visible>![Window.IsActive(gamevideofilter) | Window.IsVisible(gamestretchmode) | Window.IsVisible(gamevideorotation) | Window.IsVisible(ingamesaves) | Window.IsVisible(gamevolume) | Window.IsVisible(gamecontrollers) | Window.IsVisible(gameadvancedsettings) | Window.IsVisible(GamePorts) | Window.IsVisible(gamediscmanager) | Window.IsVisible(gameachievements) | Window.IsVisible(gameleaderboards) | Window.IsVisible(gameleaderboardentries) | Window.IsVisible(gamecheats) | Window.IsVisible(shutdownmenu)]</visible>
			<include>OSDVisibleHiddenAnimation</include>
			<include>OSDOpenCloseAnimation</include>
			<control type="group">
				<!-- The panel holds eleven rows, twelve with the disc menu or cheats and thirteen with both, and stays
				     centred: one background per count, and the whole panel 25 px lower for each row it lacks -->
				<animation effect="slide" end="0,25" time="0" condition="$EXP[GameOSDRows12]">Conditional</animation>
				<animation effect="slide" end="0,50" time="0" condition="$EXP[GameOSDRows11]">Conditional</animation>

				<!-- Window Background -->
				<control type="image">
					<include>GameOSD_coords5</include>
					<texture border="8" colordiffuse="$VAR[MenuOSDColor]">$VAR[MenuOSDPanel]</texture>
					<visible>RetroPlayer.SupportsEject + RetroPlayer.SupportsCheats</visible>
				</control>
				<control type="image">
					<include>GameOSD_coords6</include>
					<texture border="8" colordiffuse="$VAR[MenuOSDColor]">$VAR[MenuOSDPanel]</texture>
					<visible>$EXP[GameOSDRows12]</visible>
				</control>
				<control type="image">
					<include>GameOSD_coords7</include>
					<texture border="8" colordiffuse="$VAR[MenuOSDColor]">$VAR[MenuOSDPanel]</texture>
					<visible>$EXP[GameOSDRows11]</visible>
				</control>

				<!-- Heading: the game, then its platform and emulator, then what the game reports it is doing -->
				<control type="label" id="2">
					<include>GameOSD_coords8</include>
					<align>center</align>
					<aligny>top</aligny>
					<font>Font33</font>
					<label>$VAR[GameOSDHeading]</label>
				</control>
				<control type="label">
					<include>GameOSD_coords9</include>
					<align>center</align>
					<aligny>top</aligny>
					<font>Font27</font>
					<textcolor>$VAR[TextColorNF]</textcolor>
					<label>$VAR[GameOSDPlatform]</label>
				</control>
				<control type="fadelabel">
					<include>GameOSD_coords10</include>
					<align>center</align>
					<scrollspeed>44</scrollspeed>
					<font>Font27-light</font>
					<textcolor>$VAR[TextColorNF]</textcolor>
					<label>$INFO[RetroPlayer.RichPresence]</label>
				</control>

				<!-- Game OSD Buttons Grouplist -->
				<control type="grouplist" id="5">
					<include>GameOSD_coords11</include>
					<itemgap>0</itemgap>
					<orientation>vertical</orientation>
					<scrolltime tween="sine" easing="out">240</scrolltime>

					<!-- Pause/Resume button -->
					<control type="button" id="1001">
						<include>GameOSD_coords12</include>
						<aligny>top</aligny>
						<textoffsety>2</textoffsety>
						<texturefocus border="2,0,0,0" colordiffuse="$VAR[buttonfocus]">common/focus50.png</texturefocus>
						<textcolor>$VAR[TextColorNF]</textcolor>
						<focusedcolor>$VAR[TextColorFO]</focusedcolor>
						<label>$LOCALIZE[35224]</label>
						<label2>Select + X</label2>
						<onclick>Play</onclick>
					</control>

					<!-- Save and load button -->
					<control type="button" id="1002">
						<include>GameOSD_coords12</include>
						<aligny>top</aligny>
						<textoffsety>2</textoffsety>
						<texturefocus border="2,0,0,0" colordiffuse="$VAR[buttonfocus]">common/focus50.png</texturefocus>
						<textcolor>$VAR[TextColorNF]</textcolor>
						<focusedcolor>$VAR[TextColorFO]</focusedcolor>
						<label>$LOCALIZE[35249]</label>
						<onclick>ActivateWindow(InGameSaves)</onclick>
					</control>

					<!-- Disc menu button -->
					<control type="button" id="1003">
						<include>GameOSD_coords12</include>
						<aligny>top</aligny>
						<textoffsety>2</textoffsety>
						<texturefocus border="2,0,0,0" colordiffuse="$VAR[buttonfocus]">common/focus50.png</texturefocus>
						<textcolor>$VAR[TextColorNF]</textcolor>
						<focusedcolor>$VAR[TextColorFO]</focusedcolor>
						<label>$LOCALIZE[35272]</label>
						<onclick>ActivateWindow(GameDiscManager)</onclick>
						<visible>RetroPlayer.SupportsEject</visible>
					</control>

					<!-- Reset button -->
					<control type="button" id="1004">
						<include>GameOSD_coords12</include>
						<aligny>top</aligny>
						<textoffsety>2</textoffsety>
						<texturefocus border="2,0,0,0" colordiffuse="$VAR[buttonfocus]">common/focus50.png</texturefocus>
						<textcolor>$VAR[TextColorNF]</textcolor>
						<focusedcolor>$VAR[TextColorFO]</focusedcolor>
						<label>$LOCALIZE[13007]</label>
						<label2>Select + B</label2>
						<onclick>PlayerControl(Reset)</onclick>
					</control>

					<!-- Stop button -->
					<control type="button" id="1005">
						<include>GameOSD_coords12</include>
						<aligny>top</aligny>
						<textoffsety>2</textoffsety>
						<texturefocus border="2,0,0,0" colordiffuse="$VAR[buttonfocus]">common/focus50.png</texturefocus>
						<textcolor>$VAR[TextColorNF]</textcolor>
						<focusedcolor>$VAR[TextColorFO]</focusedcolor>
						<label>$LOCALIZE[35222]</label>
						<label2>Select + Start</label2>
						<onclick>Stop</onclick>
					</control>

					<!-- Spacer -->
					<control type="image" id="1006">
						<include>GameOSD_coords13</include>
						<texture>transparent.png</texture>
					</control>

					<!-- Game video filter button -->
					<control type="button" id="1007">
						<include>GameOSD_coords12</include>
						<aligny>top</aligny>
						<textoffsety>2</textoffsety>
						<texturefocus border="2,0,0,0" colordiffuse="$VAR[buttonfocus]">common/focus50.png</texturefocus>
						<textcolor>$VAR[TextColorNF]</textcolor>
						<focusedcolor>$VAR[TextColorFO]</focusedcolor>
						<label>$LOCALIZE[35225]</label>
						<onclick>ActivateWindow(GameVideoFilter)</onclick>
					</control>

					<!-- Game stretch mode button -->
					<control type="button" id="1008">
						<include>GameOSD_coords12</include>
						<aligny>top</aligny>
						<textoffsety>2</textoffsety>
						<texturefocus border="2,0,0,0" colordiffuse="$VAR[buttonfocus]">common/focus50.png</texturefocus>
						<textcolor>$VAR[TextColorNF]</textcolor>
						<focusedcolor>$VAR[TextColorFO]</focusedcolor>
						<label>$LOCALIZE[35233]</label>
						<onclick>ActivateWindow(GameStretchMode)</onclick>
					</control>

					<!-- Game video rotation button -->
					<control type="button" id="1009">
						<include>GameOSD_coords12</include>
						<aligny>top</aligny>
						<textoffsety>2</textoffsety>
						<texturefocus border="2,0,0,0" colordiffuse="$VAR[buttonfocus]">common/focus50.png</texturefocus>
						<textcolor>$VAR[TextColorNF]</textcolor>
						<focusedcolor>$VAR[TextColorFO]</focusedcolor>
						<label>$LOCALIZE[35227]</label>
						<onclick>ActivateWindow(GameVideoRotation)</onclick>
					</control>

					<!-- Game volume button -->
					<control type="button" id="1010">
						<include>GameOSD_coords12</include>
						<aligny>top</aligny>
						<textoffsety>2</textoffsety>
						<texturefocus border="2,0,0,0" colordiffuse="$VAR[buttonfocus]">common/focus50.png</texturefocus>
						<textcolor>$VAR[TextColorNF]</textcolor>
						<focusedcolor>$VAR[TextColorFO]</focusedcolor>
						<label>$LOCALIZE[13376]</label>
						<onclick>ActivateWindow(GameVolume)</onclick>
					</control>

					<!-- Spacer -->
					<control type="image" id="1011">
						<include>GameOSD_coords13</include>
						<texture>transparent.png</texture>
					</control>

					<!-- Achievements button: unlocked of total, or nothing until signed in -->
					<control type="button" id="1012">
						<include>GameOSD_coords12</include>
						<aligny>top</aligny>
						<textoffsety>2</textoffsety>
						<texturefocus border="2,0,0,0" colordiffuse="$VAR[buttonfocus]">common/focus50.png</texturefocus>
						<textcolor>$VAR[TextColorNF]</textcolor>
						<focusedcolor>$VAR[TextColorFO]</focusedcolor>
						<label>$LOCALIZE[35287]</label>
						<label2>$INFO[RetroPlayer.AchievementsProgress]</label2>
						<onclick>ActivateWindow(GameAchievements)</onclick>
					</control>

					<!-- Cheats button -->
					<control type="button" id="1013">
						<include>GameOSD_coords12</include>
						<aligny>top</aligny>
						<textoffsety>2</textoffsety>
						<texturefocus border="2,0,0,0" colordiffuse="$VAR[buttonfocus]">common/focus50.png</texturefocus>
						<textcolor>$VAR[TextColorNF]</textcolor>
						<focusedcolor>$VAR[TextColorFO]</focusedcolor>
						<label>$LOCALIZE[35320]</label>
						<onclick>ActivateWindow(GameCheats)</onclick>
						<visible>RetroPlayer.SupportsCheats</visible>
					</control>

					<!-- Controls button -->
					<control type="button" id="1014">
						<include>GameOSD_coords12</include>
						<aligny>top</aligny>
						<textoffsety>2</textoffsety>
						<texturefocus border="2,0,0,0" colordiffuse="$VAR[buttonfocus]">common/focus50.png</texturefocus>
						<textcolor>$VAR[TextColorNF]</textcolor>
						<focusedcolor>$VAR[TextColorFO]</focusedcolor>
						<label>$LOCALIZE[35234]</label>
						<onclick>ActivateWindow(GameAgents)</onclick>
					</control>

					<!-- Game advanced settings button -->
					<control type="button" id="1015">
						<include>GameOSD_coords12</include>
						<aligny>top</aligny>
						<textoffsety>2</textoffsety>
						<texturefocus border="2,0,0,0" colordiffuse="$VAR[buttonfocus]">common/focus50.png</texturefocus>
						<textcolor>$VAR[TextColorNF]</textcolor>
						<focusedcolor>$VAR[TextColorFO]</focusedcolor>
						<label>$LOCALIZE[35226]</label>
						<onclick>ActivateWindow(GameAdvancedSettings)</onclick>
					</control>
				</control>
			</control>
		</control>
	</controls>
</window>